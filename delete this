  const canBulkAction = hasPermission(LP.BULK_ACTION);
  const [selectedStatus, setSelectedStatus] = useState<string>(activeTab && activeTab !== "all" ? activeTab.replace(/(^.|-.)/g, (value) => value.replace("-", " ").toUpperCase()) : "All");
  const [specialView, setSpecialView] = useState<SpecialView>("worklist");
  const [selectedRows, setSelectedRows] = useState<Set<string>>(new Set());
