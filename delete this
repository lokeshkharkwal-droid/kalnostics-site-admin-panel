          </div>
          <div className="space-y-3">
            {deptData.map(d => (
              <div key={d.dept} className={cn("flex items-center justify-between rounded-lg px-3 py-2 text-xs", d.ok ? "bg-emerald-50" : "bg-red-50")}>
