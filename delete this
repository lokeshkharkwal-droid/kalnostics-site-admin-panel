  const [search, setSearch] = useState("");
  const WORKLIST_PAGE_SIZE = 10;
  const [worklistPage, setWorklistPage] = useState(1);
  /** The report whose TAT breakdown dialog is open (null = closed). */
  const [tatDetailsId, setTatDetailsId] = useState<string | null>(null);

  // Search is owned by the <DebouncedSearchInput> child (keystrokes re-render only
  // it, not this ~1,800-line page). It emits the debounced value here, which also
  // resets to page 1. Stable callback so the memoized child never re-renders from
  // the parent.
  const handleSearchDebounced = useCallback((value: string) => {
    setSearch(value);
    setWorklistPage(1);
  }, []);
  const [dateRange, setDateRange] = useState({ from: "", to: "" });
  const [modalType, setModalType] = useState<ModalType>(null);
  const [modalContext, setModalContext] = useState<unknown>(null);

  // Quick View ("sample-overview" modal) needs the REAL sample record — the
  // worklist row only carries `sampleId`, not sample type/container/group
  // label. Fetches on demand (only while this modal is actually open),
  // reusing Accession's own GET /accession/samples/:id + hook rather than
  // duplicating that data onto the lab-reports endpoint (see
  // TECHNICIAN-REPORTING-GAPS.md).
  const sampleOverviewSampleId =
    modalType === "sample-overview" ? (modalContext as Partial<TestWiseEntry>)?.sampleId ?? null : null;
  const { data: sampleOverviewSample } = useAccessionSample(sampleOverviewSampleId);
  const [entryOpen, setEntryOpen] = useState(false);
  const [entryFocus, setEntryFocus] = useState<TestWiseEntry | null>(null);
  const [entryScope, setEntryScope] = useState<EntryScope>("patient");
  const [entryLeftItems, setEntryLeftItems] = useState<TestWiseEntry[]>([]);

  // Shared attachment state per modal-driven dialog. Each dialog opens
  // one-at-a-time (keyed by modalType) and resets its list in its own effect.
  // TODO(attach): persist once these actions have a backend attachments endpoint
  const [modalAttach, setModalAttach] = useState<AttachmentItem[]>([]);
  useEffect(() => { setModalAttach([]); }, [modalType]);

  const [updateStatusNotes, setUpdateStatusNotes] = useState("");
  useEffect(() => { if (modalType === "update-status") setUpdateStatusNotes(""); }, [modalType]);
  const [lockNotes, setLockNotes] = useState("");
  useEffect(() => { if (modalType === "lock-test") setLockNotes(""); }, [modalType]);
  const [criticalAlertNotes, setCriticalAlertNotes] = useState("");
  useEffect(() => { if (modalType === "critical-alert") setCriticalAlertNotes(""); }, [modalType]);
  const [oorAlertNotes, setOorAlertNotes] = useState("");
  useEffect(() => { if (modalType === "oor-alert") setOorAlertNotes(""); }, [modalType]);
  const [deltaCheckNotes, setDeltaCheckNotes] = useState("");
  // Reset only — DeltaCheckContent fetches this report's real resultParams
  // itself and auto-selects the first one once they load (see its own
  // useEffect), rather than trusting the worklist row's possibly-stale/empty
  // quantResults/semiResults/qualResults copy.
  const [deltaCheckParamId, setDeltaCheckParamId] = useState<string | null>(null);
  useEffect(() => {
    if (modalType === "delta-check") {
      setDeltaCheckNotes("");
      setDeltaCheckParamId(null);
    }
  }, [modalType]);
  const [scheduleAt, setScheduleAt] = useState("");
  const [scheduleDispatchAt, setScheduleDispatchAt] = useState("");
  const [scheduleNotes, setScheduleNotes] = useState("");
  const [scheduleAssignedToId, setScheduleAssignedToId] = useState("");
  useEffect(() => {
    if (modalType === "schedule") {
      const ctx = modalContext as {
        isScheduledTest?: boolean;
        scheduledAt?: string | null;
        dispatchAt?: string | null;
        assignedToId?: string | null;
      } | null;
      setScheduleAt(ctx?.isScheduledTest ? toDatetimeLocalValue(ctx.scheduledAt) : "");
      setScheduleDispatchAt(ctx?.isScheduledTest ? toDatetimeLocalValue(ctx.dispatchAt) : "");
      setScheduleNotes("");
      setScheduleAssignedToId(ctx?.isScheduledTest ? ctx.assignedToId ?? "" : "");
    }
  }, [modalType, modalContext]);
  const [worklistStatusValue, setWorklistStatusValue] = useState("");
  useEffect(() => { if (modalType === "update-status") setWorklistStatusValue(""); }, [modalType]);

  const openModal = (type: Exclude<ModalType, null>, context?: unknown) => {
    setModalType(type);
    setModalContext(context ?? null);
  };

  const closeModal = () => {
    setModalType(null);
    setModalContext(null);
  };

  const techActionRef = useRef<{ action: string; ctx: TestWiseEntry } | null>(null);

  // ── Real worklist data (GET /lab-reports) — filtering/search/date-range/
  // source/outsource/urgent/home-collection all happen server-side now; see
  // TECHNICIAN-REPORTING-GAPS.md Part B for what this replaces. Sample Status/
  // Report Status/branch/department/etc. all send the real backend id.
  const labReportParams = useMemo<LabReportListParams>(() => {
    const params: LabReportListParams = {
      page: worklistPage,
      limit: WORKLIST_PAGE_SIZE,
    };
    if (selectedStatus !== "All") {
      params.status = LABEL_STATUS[selectedStatus as TestStatus];
    } else if (reportStatusFilter) {
      // "All Report Status" dropdown — an alternate way to set the same
      // `status` filter the status tabs above already control. The tabs win
      // when both are set (they're the primary, more visible control); the
      // dropdown only applies while the tabs are on "All".
      params.status = reportStatusFilter.id as LabReportListParams["status"];
    }
    if (sourceFilter !== "ALL") params.source = sourceFilter.replace("-", "_") as ReportSource;
    if (search) params.search = search;
    if (dateRange.from) params.dateFrom = dateRange.from;
    if (dateRange.to) params.dateTo = dateRange.to;
    if (branchFilter) params.branchId = branchFilter.id;
    if (deptFilter) params.departmentId = deptFilter.id;
    if (refPanelFilter) params.referralPanelId = refPanelFilter.id;
    if (refByFilter) params.referredByDoctorId = refByFilter.id;
    if (testNameFilter) params.branchLabTestId = testNameFilter.id;
    if (labPanelFilter) params.branchLabPanelId = labPanelFilter.id;
    if (sampleStatusFilter) {
      params.sampleStatus = sampleStatusFilter.id as LabReportListParams["sampleStatus"];
    }
    if (outsourceFilter) params.outsource = true;
    if (urgentFilter) params.urgent = true;
    if (homeCollectionFilter) params.homeCollection = true;
    return params;
  }, [
    worklistPage, selectedStatus, reportStatusFilter, sourceFilter, search, dateRange,
    branchFilter, deptFilter, refPanelFilter, refByFilter, testNameFilter, labPanelFilter,
    sampleStatusFilter, outsourceFilter, urgentFilter, homeCollectionFilter,
  ]);

  // Any filter change other than the search debounce (which already resets
  // worklistPage itself) should also jump back to page 1 — otherwise you can
  // get stuck on e.g. page 5 after switching to a status tab with only 1 page.
  useEffect(() => {
    setWorklistPage(1);
  }, [
    selectedStatus, reportStatusFilter, sourceFilter, dateRange, branchFilter, deptFilter,
    refPanelFilter, refByFilter, testNameFilter, labPanelFilter, sampleStatusFilter,
    outsourceFilter, urgentFilter, homeCollectionFilter,
  ]);

  // Same filters as labReportParams, minus status/page/limit — the status
  // tabs' own counts must reflect every status under the CURRENT filter set,
  // not just whichever status tab happens to be selected right now. source/
  // outsource are stripped for the same reason: the bySource breakdown this
  // response also carries (In-House/Outsource pill counts) must reflect
  // every OTHER active filter, not whichever source pill is selected.
  const countsParams = useMemo(() => {
    const { status: _status, page: _page, limit: _limit, source: _source, outsource: _outsource, ...rest } = labReportParams;
    return rest;
  }, [labReportParams]);

  const { data: labReportsPage, isLoading: rowsLoading, isFetching: rowsFetching } = useLabReports(labReportParams);
  const { data: labReportOptions } = useLabReportOptions();
  const { data: statusCounts, isFetching: statusCountsFetching } = useLabReportCounts(countsParams);

  // Real status-lifecycle/action mutations (LABORATORY.docx §2, §5, §6) —
  // replaces the generic technicianService.reports.update() mock pattern
  // everywhere below (see TECHNICIAN-REPORTING-GAPS.md Part B3).
  const saveMutation = useSaveReport();
  const submitMutation = useSubmitReport();
  const validateMutation = useValidateReport();
  const editReportMutation = useEditReport();
  const resubmitMutation = useResubmitReport();
  const rejectMutation = useRejectReport();
  const approveMutation = useApproveReport();
  // "Number of Signatory Authorities at Report Approval" (Technician Settings
  // → Laboratory Permissions) — drives how many Signatory Authority dropdowns
  // ApproveReportModal renders. Defaults to 1 (the backend's own default)
  // while the setting is still loading, so the dropdown count never briefly
  // flashes as 3 before settling to whatever's actually configured.
  const { data: technicianSettings } = useTechnicianSettings();
  const authoritySignatureFieldCount = (technicianSettings?.authoritySignatures ?? 1) as 1 | 2 | 3;
  const publishMutation = usePublishReport();
  const reportErrorMutation = useReportError();
  const lockMutation = useLockReport();
  const updateStatusMutation = useUpdateReportStatus();
  const reRunMutation = useRaiseReRun();
  const printMutation = usePrintReport();
  // Template-driven prints (shared picker). A worklist row's `id` is its lab
  // report id; `orderUuid` is the order it belongs to.
  const { requestPrint, printerElement } = usePrintTemplate();
  const printReportTemplate = (row: TestWiseEntry) => {
    // A panel row prints from the lab_panel template list; everything else
    // (single test / direct) uses lab_report.
    const type = row.testKind === "PANEL" ? "lab_panel" : "lab_report";
    requestPrint({
      type,
      // "Skip Selection" — print without a manual pick; the backend resolves the
      // template (per-test mapping → Configuration default → first active).
      allowSkip: true,
      print: (templateId) => printLabReport(row.id, templateId, type),
    });
  };
  const printAllReports = (row: TestWiseEntry) => {
    if (!row.orderUuid) return;
    // Print All uses a "lab_all_report" template — one continuous document that
    // iterates every test on the order (Latte engine, per-test page headers +
    // breaks). The backend routes a lab_all_report template through that path;
    // any other selected template falls back to merging per-report PDFs (see
    // `printAllForOrder` in lab-report.service.ts).
    requestPrint({
      type: "lab_all_report",
      // Also offer patient-facing "Patient Lab All Reports" templates — both
      // render through the same all-reports path (resolved by template type).
      types: ["lab_all_report", "patient_lab_all_report"],
      print: (templateId) => printAllOrderReports(row.orderUuid!, templateId),
    });
  };
  const upsertResultsMutation = useUpsertResultValues();
  const assignMultiStepMutation = useAssignMultiStepProcess();
  const [multiStepProcessType, setMultiStepProcessType] = useState("");
  const [multiStepNotes, setMultiStepNotes] = useState("");

  // Bulk action bar — dispatches through the same real mutations as the
  // single-row buttons (see STATUS_BULK_ACTIONS above for the shared
  // status -> allowed-actions table). Reject/Error Reported require notes on
  // the backend, so those two open a small confirm prompt first instead of
  // firing immediately like Validate/Approve/Publish.
  const [bulkActionPending, setBulkActionPending] = useState(false);
  const [bulkNotesRequest, setBulkNotesRequest] = useState<{ actionKey: BulkActionKey; rows: TestWiseEntry[] } | null>(null);
  const [bulkNotesValue, setBulkNotesValue] = useState("");
  // Bulk Re-Run (Order Overview's selection toolbar) loops reRunMutation
  // over each selected row — this tracks that loop's own in-flight state,
  // separate from reRunMutation.isPending (which only reflects the single
  // currently-inflight request within the loop).
  const [bulkRerunPending, setBulkRerunPending] = useState(false);

  const bulkMutationFor = (actionKey: BulkActionKey) => {
    switch (actionKey) {
      case "validate": return (id: string) => validateMutation.mutateAsync({ id });
      case "approve": return (id: string) => approveMutation.mutateAsync(id);
      case "publish": return (id: string) => publishMutation.mutateAsync(id);
      case "reject": return (id: string, notes: string) => rejectMutation.mutateAsync({ id, body: { notes } });
      case "errorReported": return (id: string, notes: string) => reportErrorMutation.mutateAsync({ id, body: { notes } });
    }
  };

  const runBulkAction = async (actionKey: BulkActionKey, rowsToUpdate: TestWiseEntry[], notes?: string) => {
    if (!rowsToUpdate.length) return;
    setBulkActionPending(true);
    const mutate = bulkMutationFor(actionKey);
    let succeeded = 0;
    for (const row of rowsToUpdate) {
      try {
        await mutate(row.id, notes as string);
        succeeded++;
      } catch {
        // Individual failures (e.g. a row whose status changed since
        // selection) are reported in the summary below, not per-row —
        // matches the previous bulk UX rather than interrupting the batch.
      }
    }
    setBulkActionPending(false);
    const { label } = BULK_ACTION_META[actionKey];
    if (succeeded === rowsToUpdate.length) {
      toast.success(`${label} — ${succeeded} test(s) updated`);
    } else if (succeeded > 0) {
      toast.warning(`${label} — ${succeeded}/${rowsToUpdate.length} test(s) updated, ${rowsToUpdate.length - succeeded} failed`);
    } else {
      toast.error(`${label} — failed`);
    }
    setSelectedRows(new Set());
  };

  const handleBulkActionClick = (actionKey: BulkActionKey, rowsToUpdate: TestWiseEntry[]) => {
    if (BULK_ACTION_META[actionKey].requiresNotes) {
      setBulkNotesValue("");
      setBulkNotesRequest({ actionKey, rows: rowsToUpdate });
      return;
    }
    void runBulkAction(actionKey, rowsToUpdate);
  };
  useEffect(() => {
    if (modalType === "multistep") { setMultiStepProcessType(""); setMultiStepNotes(""); }
  }, [modalType]);

  // The 5 special worklists (LABORATORY.docx §8) — real data + real mutations.
  // Each still fetches everything (no pagination — see TECHNICIAN-REPORTING-
  // GAPS.md B2). Switching tabs should show fresh data, but rapid re-clicks
  // (e.g. flicking between tabs) shouldn't spam the backend — so each query
  // sets its own `staleTime`, and the tab click only calls `refetch()` when
  // `dataUpdatedAt` shows that window has actually elapsed. This reuses
  // useQuery's own staleness bookkeeping instead of a separate hand-rolled
  // timer/debounce.
  const WORKLIST_TAB_STALE_MS = 5_000;
  const reRunQuery = useReRunRequests();
  const criticalAlertsQuery = useCriticalAlerts();
  const outOfRangeQuery = useOutOfRangeFlags();
  const deltaCheckQuery = useDeltaChecks();
  const scheduledTestQuery = useScheduledTests();
  const { data: reRunRequests, isLoading: reRunLoading, isFetching: reRunFetching } = reRunQuery;
  const { data: criticalAlerts, isLoading: criticalAlertsLoading, isFetching: criticalAlertsFetching } = criticalAlertsQuery;
  const { data: outOfRangeFlags, isLoading: outOfRangeLoading, isFetching: outOfRangeFetching } = outOfRangeQuery;
  const { data: deltaChecks, isLoading: deltaCheckLoading, isFetching: deltaCheckFetching } = deltaCheckQuery;
  const { data: scheduledTests, isLoading: scheduledTestLoading, isFetching: scheduledTestFetching } = scheduledTestQuery;

  // Only `dataUpdatedAt`/`refetch` are read below — a narrow shared shape
  // instead of `typeof reRunQuery` lets this map hold all 5 differently-typed
  // (ApiReRunRequest/ApiCriticalAlert/.../ApiScheduledTest) query results.
  const REFETCH_ON_TAB: Partial<Record<SpecialView, { dataUpdatedAt: number; refetch: () => void }>> = {
    "Re-Run": reRunQuery,
    "Critical Alerts": criticalAlertsQuery,
    "Out of Range": outOfRangeQuery,
    "Delta Check": deltaCheckQuery,
    "Schedule Test": scheduledTestQuery,
  };
  // Pill badge counts: how many entries on each special worklist are still
  // short of their terminal ("done") status — Re-Run: Completed/Cancelled;
  // Critical Alerts/Out of Range/Delta Check: Resolved; Schedule Test:
  // Completed. Every `findAll` above returns the full branch list with no
  // pagination, so counting client-side is accurate, not just page 1.
  const pendingCounts = useMemo<Partial<Record<SpecialView, number>>>(
    () => ({
      "Re-Run": (reRunRequests ?? []).filter((r) => r.status !== "COMPLETED" && r.status !== "CANCELLED").length,
      "Critical Alerts": (criticalAlerts ?? []).filter((a) => a.status !== "RESOLVED").length,
      "Out of Range": (outOfRangeFlags ?? []).filter((a) => a.status !== "RESOLVED").length,
      "Delta Check": (deltaChecks ?? []).filter((a) => a.status !== "RESOLVED").length,
      "Schedule Test": (scheduledTests ?? []).filter((s) => s.status !== "COMPLETED").length,
    }),
    [reRunRequests, criticalAlerts, outOfRangeFlags, deltaChecks, scheduledTests],
  );
  const selectSpecialView = (view: SpecialView) => {
    setSpecialView(view);
    const query = REFETCH_ON_TAB[view];
    if (!query) return;
    const elapsed = Date.now() - query.dataUpdatedAt;
    if (elapsed >= WORKLIST_TAB_STALE_MS) query.refetch();
  };
  const raiseCriticalAlertMutation = useRaiseCriticalAlert();
  const raiseOutOfRangeMutation = useRaiseOutOfRange();
  const raiseDeltaCheckMutation = useRaiseDeltaCheck();
  const scheduleTestMutation = useScheduleTest();
  const rescheduleTestMutation = useRescheduleTest();
  const updateReRunStatusMutation = useUpdateReRunStatus();
  const updateCriticalAlertStatusMutation = useUpdateCriticalAlertStatus();
  const updateOutOfRangeStatusMutation = useUpdateOutOfRangeStatus();
  const updateDeltaCheckStatusMutation = useUpdateDeltaCheckStatus();
  const updateScheduledTestStatusMutation = useUpdateScheduledTestStatus();

  const serverRows = useMemo<TestWiseEntry[]>(
    () => (labReportsPage?.data ?? []).map((row, i) => toTestWiseEntry(row, i + 1)),
    [labReportsPage],
  );

  // Local shadow copy so the (still mock-wired, per our step-by-step plan)
  // action buttons can keep doing optimistic local edits without a full
  // rewrite in this pass — reset whenever a fresh server page lands.
  const [localRowEdits, setLocalRowEdits] = useState<Record<string, TestWiseEntry>>({});
  useEffect(() => { setLocalRowEdits({}); }, [labReportsPage]);
  const rows = useMemo<TestWiseEntry[]>(
    () => serverRows.map((r) => localRowEdits[r.id] ?? r),
    [serverRows, localRowEdits],
  );
  const setRows = useCallback(
    (updater: TestWiseEntry[] | ((current: TestWiseEntry[]) => TestWiseEntry[])) => {
      setLocalRowEdits((current) => {
        const currentRows = serverRows.map((r) => current[r.id] ?? r);
        const nextRows = typeof updater === "function" ? updater(currentRows) : updater;
        const next: Record<string, TestWiseEntry> = { ...current };
        nextRows.forEach((r) => { next[r.id] = r; });
        return next;
      });
    },
    [serverRows],
  );

  useEffect(() => {
    seedReportsIfEmpty(seedRows);
  }, []);

  // Every filter dropdown below is a PaginatedSelect for consistency, even
  // though only 6 of them (Branch/Ref By/Panel/Department/Lab Test/Lab Panel)
  // page against a real backend list — Sample Status/Report Status wrap the
  // fixed enum lists from GET /lab-reports/options in a single-page fetchPage
  // (fetchStaticOptions) since there's nothing to actually paginate there.
  const fetchBranchOptions = (p: { page: number; search: string; pageSize: number }) =>
    listBranchOptionsPaged(p);
  const fetchRefByOptions = (p: { page: number; search: string; pageSize: number }) =>
    listReferralDoctorOptionsPaged(p);
  const fetchRefPanelOptions = (p: { page: number; search: string; pageSize: number }) =>
    listReferralPanelOptionsPaged(p);
  const fetchDeptOptions = (p: { page: number; search: string; pageSize: number }) =>
    listDepartmentOptionsPaged(p);
  const fetchLabTestOptions = (p: { page: number; search: string; pageSize: number }) =>
    listLabReportTestOptionsPaged(p);
  const fetchLabPanelOptions = (p: { page: number; search: string; pageSize: number }) =>
    listLabReportPanelOptionsPaged(p);

  /** Wrap an already-fetched, fixed-size `{ id, name }[]` (an enum list) as a
   * PaginatedSelect fetchPage — one page, client-side name filter, so the
   * Sample Status/Report Status filters use the same component as every
   * other filter here without a real backend list behind them. */
  const fetchStaticOptions = (all: { id: string; name: string }[]) =>
    ({ search }: { page: number; search: string; pageSize: number }) => {
      const term = search.trim().toLowerCase();
      const data = term ? all.filter((o) => o.name.toLowerCase().includes(term)) : all;
      return Promise.resolve({
        data,
        meta: { total: data.length, page: 1, limit: data.length || 1, totalPages: 1 },
      });
    };
  const fetchSampleStatusOptions = fetchStaticOptions(
    (labReportOptions?.sampleStatuses ?? []).map((s) => ({ id: s, name: s })),
  );
  const fetchReportStatusOptions = fetchStaticOptions(
    (labReportOptions?.reportStatuses ?? []).map((s) => ({ id: s, name: STATUS_LABEL[s] })),
  );

  // Filtering/search/date-range now all happen server-side (labReportParams
  // above) — `rows` is already exactly the filtered, real page. `filteredRows`
  // stays as an alias so the large amount of downstream code (sort, paging,
  // bulk actions) that reads `filteredRows` keeps working unchanged.
  const filteredRows = rows;

  // `filteredRows` is already exactly one server page (see labReportParams
  // above) — DataTable's own column sort only reorders the current page, it
  // does not re-sort the full backend result set (no sortBy/sortDir param
  // exists yet).
  const sortedFilteredRows = filteredRows;

  const worklistColumns = useMemo<ColumnDef<TestWiseEntry>[]>(() => [
    {
      key: "srNo", header: "SR",
      render: (_v, _r, i) => (worklistPage - 1) * WORKLIST_PAGE_SIZE + i + 1,
    },
    {
      key: "orderId", header: "Order ID", sortable: true, sortAccessor: (r) => r.orderId,
      render: (_v, row) => (
        <>
          <button type="button" className="font-mono text-xs font-semibold text-blue-600 hover:underline" title="Diagnostics Order Details" onClick={(event) => { event.stopPropagation(); openModal("order-overview", row); }}>{row.orderId}</button>
          <div className="small" title="Order creation date & time">{row.isOutsourced ? "OUTSOURCE" : "IN-HOUSE"} • {row.orderDate}</div>
          <div className="mt-1"><StatusBadge value={row.tatSeverity} /></div>
        </>
      ),
    },
    {
      key: "sampleBarcode", header: "Barcode", sortable: true, sortAccessor: (r) => r.sampleBarcode,
      render: (_v, row) => <span className="font-mono text-xs">{row.sampleBarcode}</span>,
    },
    {
      key: "patient", header: "Patient Details", sortable: true, sortAccessor: (r) => r.patientName,
      render: (_v, row) => (
        <>
          <div className="font-medium text-slate-800">{row.patientName}</div>
          <div className="small">{row.patientAge}y / {row.patientGender} • {row.umiId}</div>
        </>
      ),
    },
    {
      key: "branch", header: "Branch", sortable: true, sortAccessor: (r) => r.branch,
      className: "text-slate-600",
    },
    {
      key: "department", header: "Department", sortable: true, sortAccessor: (r) => r.department ?? "",
      render: (_v, row) => row.department ?? "—",
      className: "text-slate-600",
    },
    {
      key: "refPanel", header: "Ref Panel", sortable: true, sortAccessor: (r) => r.refPanel ?? "",
      className: "text-slate-600",
    },
    {
      key: "refBy", header: "Ref By", sortable: true, sortAccessor: (r) => r.refBy ?? "",
      className: "text-slate-600",
    },
    {
      key: "testName", header: "Test Name", sortable: true, sortAccessor: (r) => r.testName,
      render: (_v, row) => (
        <>
          <div className="font-medium text-slate-800">{row.testName}</div>
          <div className="small">{row.testType}</div>
        </>
      ),
    },
    {
      key: "sampleStatus", header: "Sample Status", sortable: true, sortAccessor: (r) => r.sampleStatus,
      render: (_v, row) => <StatusBadge value={row.sampleStatus} />,
    },
    {
      key: "reportStatus", header: "Report Status", sortable: true, sortAccessor: (r) => r.status,
      render: (_v, row) => <StatusBadge value={row.status} />,
    },
    {
      // Shows time REMAINING (max - elapsed), not elapsed — sortAccessor uses
      // Infinity (not -1) for "no remaining figure" so unsortable rows fall to
      // the end under ascending (most-urgent-first) sort instead of the front.
      key: "tatTime", header: "TAT Time", sortable: true, sortAccessor: (r) => r.tatRemainingMinutes ?? Infinity,
      render: (_v, row) => (
        <button
          type="button"
          className="font-mono text-xs font-semibold text-blue-600 hover:underline disabled:cursor-default disabled:text-slate-400 disabled:no-underline"
          disabled={!row.tatComputable}
          title={row.tatComputable ? "View TAT breakdown" : "TAT not available"}
          onClick={(event) => { event.stopPropagation(); setTatDetailsId(row.id); }}
        >
          {formatTatMinutes(row.tatRemainingMinutes)}
        </button>
      ),
    },
  ], [worklistPage]);

  const nextStatus = (status: TestStatus): TestStatus =>
    status === "Validation Pending" ? "Result Done" :
    status === "Result Done" ? "Approved" :
    status === "Approved" ? "Published" :
    "Validation Pending";

  // Local-only optimistic edit of the shadow row state — result-value edits
  // are no longer persisted through the old generic mock endpoint; actual
  // persistence happens via useUpsertResultValues/useSaveReport/
  // useSubmitReport, called directly from EntryModal against real
  // resultParamId's (see mergeResultParams in utils/lab-report-adapter.ts).
  const updateEntry = (entry: TestWiseEntry) => {
    setRows((current) => current.map((item) => item.id === entry.id ? entry : item));
  };

  const openEntry = (entry: TestWiseEntry, scope: EntryScope) => {
    setEntryFocus(entry);
    setEntryScope(scope);
    // Left list is scoped to the active panel's status (the worklist itself is
    // already server-filtered by it); "All" shows every order on the page.
    const filtered = selectedStatus === "All" ? rows : rows.filter(r => r.status === selectedStatus);
    if (scope === "patient") {
      // One entry per Patient+Order — a patient with multiple orders shows once
      // per order, keyed on the order UUID (fallback to order code + patient
      // when the UUID is absent). Selecting one loads only that order's tests.
      const seen = new Set<string>();
      setEntryLeftItems(filtered.filter(r => {
        const key = r.orderUuid ?? `${r.orderId}|${r.patientName}`;
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      }));
    } else {
      setEntryLeftItems(filtered);
    }
    setEntryOpen(true);
  };

  const actionButtons = (row: TestWiseEntry) => {
    const open = () => openEntry(row, "test");
    const ib = (icon: JSX.Element, title: string, onClick: () => void, cls = "", disabled = false) => (
      <button
        type="button"
        title={disabled ? `${title} (report is locked)` : title}
        disabled={disabled}
        onClick={(e) => { e.stopPropagation(); onClick(); }}
        className={cn("ib", cls, disabled && "opacity-30 cursor-not-allowed")}
      >{icon}</button>
    );

    // B2B referral-panel users: no actions by default. Only an Approved report
    // exposes Print + Print Report — nothing else.
    if (isB2b) {
      if (row.status !== "Approved") {
        return <div className="flex items-center gap-1 flex-nowrap whitespace-nowrap" />;
      }
      return (
        <div className="flex items-center gap-1 flex-nowrap whitespace-nowrap">
          {ib(<Printer className="h-3.5 w-3.5" />, "Print", () => openModal("report-view", row))}
          {ib(<Printer className="h-3.5 w-3.5" />, "Print Report (choose template)", () => printReportTemplate(row), "green")}
        </div>
      );
    }

    // Actions the real backend rejects when the report is locked (see
    // LabReportService.requireReport, called from save/submit/validate/
    // editReport/reject/resubmit/approve/publish/errorReported/updateStatus/
    // createNote). Re-Run, Print, Trend, Audit Trail, and Quick View are all
    // NOT gated by the backend — Re-Run is explicitly allowed from any
    // status/lock state, and the rest are read-only — so they stay enabled.
    const locked = row.isLocked;

    // Permission gates (mirror the backend route guards on the lab-report
    // actions). Working a status queue is gated by "access to <that status>".
    const noPerm = "You do not have permission for this action";
    const canEnter = hasPermission(LP.ENTER_RESULT);
    const canValidate = hasPermission(LP.ACCESS_VALIDATION_PENDING);
    const canApprove = hasPermission(LP.ACCESS_RESULT_DONE);
    const canPublish = hasPermission(LP.ACCESS_APPROVED);
    const canEdit = hasPermission(LP.EDIT_REPORT);
    const canReject = hasPermission(LP.MARK_RESULT_REJECTED);
    const canError = hasPermission(LP.MARK_ERROR_REPORTED);
    const canResubmit =
      hasPermission(LP.ACCESS_RESULT_REJECTED) ||
      hasPermission(LP.ACCESS_ERROR_REPORTED);
    const canNotes = hasPermission(LP.UPDATE_TECH_NOTES);
    const canRerun = hasPermission(LP.MARK_RE_RUN);
    const canTrend = hasPermission(LP.VIEW_TREND_REPORT);

    const statusPart = (() => {
      if (row.status === "Pending") return (<>
        <Button size="sm" variant="outline" disabled={locked || !canEnter} title={!canEnter ? noPerm : locked ? "Report is locked" : undefined} onClick={(e) => { e.stopPropagation(); open(); }}>Enter</Button>
        {ib(<Eye className="h-3.5 w-3.5" />, "Quick View", () => openModal("sample-overview", row))}
      </>);
      if (row.status === "Partial Pending") return (<>
        <Button size="sm" variant="outline" disabled={locked || !canEnter} title={!canEnter ? noPerm : locked ? "Report is locked" : undefined} onClick={(e) => { e.stopPropagation(); open(); }}>Enter</Button>
        {ib(<Eye className="h-3.5 w-3.5" />, "Quick View", () => openModal("sample-overview", row))}
      </>);
      if (row.status === "Saved") return (<>
        <Button size="sm" variant="outline" disabled={locked || !canEnter} title={!canEnter ? noPerm : locked ? "Report is locked" : undefined} onClick={(e) => { e.stopPropagation(); open(); }}>Enter</Button>
        {ib(<Eye className="h-3.5 w-3.5" />, "Quick View", () => openModal("sample-overview", row))}
        {canRerun && ib(<RotateCcw className="h-3.5 w-3.5" />, "Re-run", () => openModal("rerun", row), "red")}
        {ib(<Printer className="h-3.5 w-3.5" />, "Print", () => openModal("report-view", row))}
      </>);
      if (row.status === "Validation Pending") return (<>
        <Button size="sm" variant="outline" className="text-green-700" disabled={locked || !canValidate} title={!canValidate ? noPerm : locked ? "Report is locked" : undefined} onClick={(e) => { e.stopPropagation(); openModal("validate", row); }}>Validate</Button>
        {canEdit && ib(<Pencil className="h-3.5 w-3.5" />, "Edit Report", () => openModal("edit-report", row), "orange", locked)}
        {ib(<Eye className="h-3.5 w-3.5" />, "Quick View", () => openModal("sample-overview", row))}
        {canRerun && ib(<RotateCcw className="h-3.5 w-3.5" />, "Re-run", () => openModal("rerun", row), "red")}
        {ib(<Printer className="h-3.5 w-3.5" />, "Print", () => openModal("report-view", row))}
        {canReject && ib(<XCircle className="h-3.5 w-3.5" />, "Reject", () => openModal("reject", row), "red", locked)}
      </>);
      if (row.status === "Result Done") return (<>
        <Button size="sm" variant="outline" className="text-green-700" disabled={locked || !canApprove} title={!canApprove ? noPerm : locked ? "Report is locked" : undefined} onClick={(e) => { e.stopPropagation(); openModal("approve", row); }}>Approve</Button>
        {ib(<Eye className="h-3.5 w-3.5" />, "Quick View", () => openModal("sample-overview", row))}
        {canEdit && ib(<Pencil className="h-3.5 w-3.5" />, "Edit Report", () => openModal("edit-report", row), "orange", locked)}
        {canRerun && ib(<RotateCcw className="h-3.5 w-3.5" />, "Re-run", () => openModal("rerun", row), "red")}
        {canTrend && ib(<TrendingUp className="h-3.5 w-3.5" />, "Trend", () => openModal("trend", row), "purple")}
        {ib(<Printer className="h-3.5 w-3.5" />, "Print", () => openModal("report-view", row))}
      </>);
      if (row.status === "Approved") return (<>
        <Button size="sm" disabled={locked || !canPublish} title={!canPublish ? noPerm : locked ? "Report is locked" : undefined} onClick={(e) => { e.stopPropagation(); openModal("publish", row); }}>Publish</Button>
        {ib(<Eye className="h-3.5 w-3.5" />, "Quick View", () => openModal("sample-overview", row))}
        {canEdit && ib(<Pencil className="h-3.5 w-3.5" />, "Edit Report", () => openModal("edit-report", row), "orange", locked)}
        {canRerun && ib(<RotateCcw className="h-3.5 w-3.5" />, "Re-run", () => openModal("rerun", row), "red")}
        {canTrend && ib(<TrendingUp className="h-3.5 w-3.5" />, "Trend", () => openModal("trend", row), "purple")}
        {ib(<Printer className="h-3.5 w-3.5" />, "Print", () => openModal("report-view", row))}
        {canError && ib(<AlertTriangle className="h-3.5 w-3.5" />, "Error Reported", () => openModal("error", row), "red", locked)}
      </>);
      if (row.status === "Published") return (<>
        {ib(<Eye className="h-3.5 w-3.5" />, "Quick View", () => openModal("sample-overview", row))}
        {ib(<Printer className="h-3.5 w-3.5" />, "Print", () => openModal("report-view", row))}
        {canError && ib(<AlertTriangle className="h-3.5 w-3.5" />, "Error Reported", () => openModal("error", row), "red", locked)}
        {/* Bug fix: the backend's Re-Run transition (resetForRerun) is allowed
           from ANY status, including Published — but this branch never
           offered the icon, forcing a technician to raise Error Reported
           first just to unlock Re-Run elsewhere, polluting the audit trail
           with an unintended "error reported" event. */}
        {canRerun && ib(<RotateCcw className="h-3.5 w-3.5" />, "Re-run", () => openModal("rerun", row), "red")}
        {canTrend && ib(<TrendingUp className="h-3.5 w-3.5" />, "Trend", () => openModal("trend", row), "purple")}
      </>);
      /* Error Reported | Result Rejected — Resubmit (POST /resubmit, the only
         real backend transition allowed from these two statuses) returns the
         report to Validation Pending. */
      return (<>
        <Button size="sm" variant="outline" className="text-orange-700" disabled={locked || !canResubmit} title={!canResubmit ? noPerm : locked ? "Report is locked" : undefined} onClick={(e) => { e.stopPropagation(); openModal("resubmit", row); }}>Resubmit</Button>
        {ib(<Eye className="h-3.5 w-3.5" />, "Quick View", () => openModal("sample-overview", row))}
        {canRerun && ib(<RotateCcw className="h-3.5 w-3.5" />, "Re-run", () => openModal("rerun", row), "red")}
        {ib(<Printer className="h-3.5 w-3.5" />, "Print", () => openModal("report-view", row))}
      </>);
    })();

    return (
      <div className="flex items-center gap-1 flex-nowrap whitespace-nowrap">
        {statusPart}
        {ib(<Printer className="h-3.5 w-3.5" />, "Print Report (choose template)", () => printReportTemplate(row), "green")}
        {ib(<FileText className="h-3.5 w-3.5" />, "Print All Reports (whole order)", () => printAllReports(row), "purple", !row.orderUuid)}
        {canNotes && ib(<ListChecks className="h-3.5 w-3.5" />, "Technician Notes", () => openModal("update-status", row), "purple", locked)}
        {ib(<ClipboardList className="h-3.5 w-3.5" />, "Audit Trail", () => openModal("audit", row))}
      </div>
    );
  };

  const renderWorklist = () => {
    const selectedList = filteredRows.filter(r => selectedRows.has(r.id));
    const hasAnyStatus = (s: TestStatus) => selectedList.some(r => r.status === s);

    /* Spec-driven bulk actions per active status chip.
       When the active chip is "All", we still show the union for whichever
       statuses appear in the selection so multi-status batches stay usable. */
    const exportSelectedCsv = () => {
      const headers = ["Order ID", "Patient", "Test", "Dept", "Status", "Sample Status", "Date", "Branch"];
      const rows2 = selectedList.map(r => [r.orderId, r.patientName, r.testName, r.department ?? "", r.status, r.sampleStatus, r.acceptedDate, r.branch ?? ""].map(v => `"${String(v).replace(/"/g, '""')}"`).join(","));
      const csv = [headers.join(","), ...rows2].join("\n");
      const a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
      a.download = `worklist-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      toast.success(`Exported ${selectedList.length} row(s)`);
    };
    const showFor = (s: TestStatus) => selectedStatus === s || (selectedStatus === "All" && hasAnyStatus(s));

    return (
    <>
      {/* ── Bulk action bar — buttons derived from STATUS_BULK_ACTIONS, the
           single shared status -> allowed-actions table (mirrors the real
           backend's LAB_REPORT_ALLOWED_FROM), instead of separate
           hand-written per-status blocks. When the active chip is "All", we
           still show the union for whichever statuses appear in the
           selection so multi-status batches stay usable; each button only
           ever targets the rows actually in its matching status. ── */}
      {canBulkAction && selectedRows.size > 0 && (
        <div className="flex flex-wrap items-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-4 py-2.5">
          <span className="text-xs font-semibold text-blue-700">{selectedRows.size} selected</span>
          <div className="h-4 w-px bg-blue-200" />
          {(Object.keys(STATUS_BULK_ACTIONS) as TestStatus[])
            .filter(showFor)
            .flatMap((status) => STATUS_BULK_ACTIONS[status] ?? [])
            .filter((actionKey, index, all) => all.indexOf(actionKey) === index) // de-dupe (e.g. "reject" appears under both Validation Pending and Result Done)
            .map((actionKey) => {
              const meta = BULK_ACTION_META[actionKey];
              const Icon = meta.icon;
              const matchingStatus = selectedList.filter((r) =>
                (STATUS_BULK_ACTIONS[r.status] ?? []).includes(actionKey),
              );
              // Every bulk action here is lock-gated on the real backend —
              // exclude locked rows from the batch instead of sending them
              // and letting them fail individually.
              const rowsForAction = matchingStatus.filter((r) => !r.isLocked);
              const lockedCount = matchingStatus.length - rowsForAction.length;
              if (!rowsForAction.length) return null;
              return (
                <button
                  key={actionKey}
                  type="button"
                  disabled={bulkActionPending}
                  title={lockedCount > 0 ? `${lockedCount} locked row(s) excluded` : undefined}
                  className={cn("flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium disabled:opacity-50", meta.hoverClass)}
                  onClick={() => handleBulkActionClick(actionKey, rowsForAction)}
                >
                  {bulkActionPending
                    ? <Loader2 className="h-3.5 w-3.5 animate-spin" />
                    : <Icon className={cn("h-3.5 w-3.5", meta.iconClass)} />}
                  {meta.label}{lockedCount > 0 ? ` (${lockedCount} locked)` : ""}
                </button>
              );
            })}
          {/* Export All — common across all statuses */}
          <button type="button" className="flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium hover:bg-gray-50"
