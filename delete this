            <NotesRichTextEditor
              value={content}
              minHeight={420}
              maxHeight={520}
              placeholder="Apply a template above, or type the overall result…"
              onChange={onChange}
            />
          ) : content ? (
            <div
              className="notes-rte-content max-w-full break-words text-sm text-slate-600 [&_img]:max-w-full"
              dangerouslySetInnerHTML={{ __html: sanitizeRichTextHTML(content) }}
