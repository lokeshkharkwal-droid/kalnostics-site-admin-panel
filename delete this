/**
 * Real Audit Trail entries for one report — fetched from `GET
 * /lab-reports/:id/history`, replacing the old hardcoded 2-entry placeholder.
 * Each row already records a genuine status transition (see
 * `LabReportService.recordHistory`, called from every Save/Submit/Validate/
 * Approve/Publish/Reject/Resubmit action), so this now shows the real,
 * complete history rather than always the same 2 fake lines.
 */
function AuditTrailEvents({ entry }: { entry: Partial<TestWiseEntry> | undefined }) {
  const { data: history, isLoading, isError } = useLabReportHistory(entry?.id ?? null);

  if (!entry?.id) return <div className="text-sm text-slate-400">No report selected.</div>;
  if (isLoading) return <div className="text-sm text-slate-400">Loading history…</div>;
  if (isError) return <div className="text-sm text-red-500">Could not load audit trail.</div>;
  if (!history || history.length === 0) {
    return <div className="text-sm text-slate-400">No history recorded yet.</div>;
  }

  return (
    <>
      {history.map((ev) => {
        const statusLabel = STATUS_LABEL[ev.toStatus];
        const fromLabel = ev.fromStatus ? STATUS_LABEL[ev.fromStatus] : null;
        const actor = ev.actorName ?? "Unknown";
        const note = ev.notes ?? (fromLabel ? `${fromLabel} → ${statusLabel}` : statusLabel);
        return (
          <div key={ev.id} className="border-l-2 border-blue-300 pl-3">
            <div className="flex items-center gap-2">
              <StatusBadge value={statusLabel} />
              {/* `formatOrderDate` expects a split date+time pair (order.orderDate
                 + order.orderTime) — history rows have one combined ISO
                 timestamp instead, so passing `null` for time silently dropped
                 it, showing only the date. */}
              <span className="text-xs text-slate-400">{new Date(ev.createdAt).toLocaleString()}</span>
              <span className="text-xs text-slate-500">by {actor}</span>
            </div>
            <div className="mt-1 text-sm text-slate-700">{note}</div>
          </div>
        );
      })}
    </>
  );
}

/** Fetches `GET /lab-reports/:id` for one expanded Test Entry row and merges
 * its real `resultParams`/`resultValues` into the entry's mock-shaped
 * quant/semi/qual arrays (see mergeResultParams). Mounted once per expanded
 * row so React Query's per-id cache does the fetch de-dup; calls `onMerged`
 * exactly once per successful fetch rather than on every render. */
function ResultEntryFetcher({
  entryId,
  onMerged,
}: {
  entryId: string;
  onMerged: (detail: ApiLabReportDetail) => void;
}) {
  const { data } = useLabReport(entryId);
  const mergedRef = useRef<ApiLabReportDetail | null>(null);
  useEffect(() => {
    if (data && mergedRef.current !== data) {
      mergedRef.current = data;
      onMerged(data);
    }
  }, [data, onMerged]);
  return null;
}



