      </DialogContent>
    </Dialog>
  );
}

/** Formats one candidate's label for the Range dropdown: rows scoped to an
 * analyzer lead with the adapter name ("Mindray BC-5130 · Cyanmethemoglobin ·
 * g/dL · 12.0-16.0"); rows with no analyzer omit that segment entirely
 * ("Cyanmethemoglobin · g/dL · 12.0-16.0") since there's no adapter to name. */
function formatRangeCandidateLabel(c: ApiReferenceRangeCandidate): string {
  const parts = [
    c.labAdapterId ? c.labAdapterName ?? "Unassigned adapter" : null,
    c.method || "—",
    c.unit || "—",
    c.referenceDisplay || "—",
  ].filter((p): p is string => !!p);
  return parts.join(" · ");
}

/** Range dropdown for one Quantitative result row — lists every
 * `LabTestReferenceRange` (with or without an analyzer) matching this
 * report's patient gender/age, via `GET /lab-reports/:id/reference-range/
 * candidates`. Picking a candidate applies its Unit/Method/Range together
 * (the caller's `onSelect`), same as what Sync already does for a single
 * auto-resolved match — this just lets the technician pick directly. Method
 * is never independently editable on any row (Quantitative or Semi-
 * Quantitative) — it's always derived, from the picked Range here, or from
 * the parameter's own configured `LabTestResultParam.method` otherwise — so
 * only Quantitative gets this dropdown; Semi-Quantitative/Qualitative rows
 * have no analyzer-scoped ranges to pick a Range from yet (see the endpoint's
 * own doc comment) and keep the plain-text reference display they already
 * have.
 *
 * Defined at module scope (not nested inside EntryModal/resultBlock) so its
 * component identity is stable across renders — nesting it would remount
 * every instance (and reset its `open` state) on every EntryModal re-render,
 * e.g. every keystroke in a sibling Observed input. */
function RangeSelect({
  reportId,
  resultParamId,
  value,
  onSelect,
}: {
  reportId: string;
  resultParamId: string;
  value: string | undefined;
  onSelect: (candidate: ApiReferenceRangeCandidate) => void;
}) {
  const { data, isLoading } = useReferenceRangeCandidates(reportId, resultParamId);
  const candidates = data?.candidates ?? [];

  // Auto-select the first Default-marked candidate the moment the group
  // opens (candidates load), but ONLY when this row has no Range yet — a
  // previously saved/picked value always wins and is never silently
  // overwritten on reload. `autoSelectedRef` stops this from re-firing every
  // time the candidates list refetches (e.g. after Save) once it's already
  // made its one auto-pick for this row.
  const autoSelectedRef = useRef(false);
  useEffect(() => {
    if (autoSelectedRef.current) return;
    if (value) { autoSelectedRef.current = true; return; }
    if (!candidates.length) return;
    const def = candidates.find((c) => c.isDefault);
    if (def) {
      autoSelectedRef.current = true;
      onSelect(def);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [candidates.length]);

  return (
    <Select
      value={value ?? ""}
      onValueChange={(id) => {
        const candidate = candidates.find((c) => c.id === id);
        if (candidate) onSelect(candidate);
      }}
    >
      {/* `overflow-hidden` + the inner span's `truncate` keep a long label
          ("Adapter · Method · Unit · Range") on one line and clipped with an
          ellipsis instead of wrapping — without this, the trigger's content
          could grow taller than the fixed `h-7` and visually bleed into the
          row below (the whole point of `line-clamp-1` on the base
          SelectTrigger, but that only clamps a direct `<span>` child, not
          this custom icon+text span one level deeper). */}
      <SelectTrigger className="h-7 px-2 text-xs overflow-hidden"><SelectValue placeholder="Range" /></SelectTrigger>
      <SelectContent>
        {isLoading && <div className="px-2 py-1.5 text-xs text-slate-400">Loading…</div>}
        {!isLoading && candidates.length === 0 && (
          <div className="px-2 py-1.5 text-xs text-slate-400">No matching range configured</div>
        )}
        {candidates.map((c) => (
          <SelectItem key={c.id} value={c.id}>
            <span className="inline-flex items-center gap-1 min-w-0">
              {c.isDefault && <Star className="w-3 h-3 text-green-600 fill-green-600 shrink-0" />}
              <span className="truncate">{formatRangeCandidateLabel(c)}</span>
            </span>
          </SelectItem>
        ))}
      </SelectContent>
    </Select>
  );
}

