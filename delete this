/* Generate Inventory dialog rows — Allocated + Re-Run + Wastage = Total (auto) */
type InvRow = {
  id: number;
  usageId?: string; // present for rows loaded from the backend; absent for new, unsaved rows
  material: string; batch: string; expiry: string;
  allocPU: string; allocBU: string; rerunPU: string; rerunBU: string;
  wastePU: string; wasteBU: string; remarks: string;
};
const blankInvRow = (id: number): InvRow => ({ id, material: "", batch: "", expiry: "", allocPU: "", allocBU: "", rerunPU: "", rerunBU: "", wastePU: "", wasteBU: "", remarks: "" });
const usageToInvRow = (id: number, usage: ApiInventoryUsage): InvRow => ({
  id,
  usageId: usage.id,
  material: usage.inventoryItemId,
  batch: usage.batchNumber ?? "",
  expiry: usage.expiryDate ?? "",
  allocPU: usage.allocatedPu ? String(usage.allocatedPu) : "",
  allocBU: usage.allocatedBu ? String(usage.allocatedBu) : "",
  rerunPU: usage.reRunPu ? String(usage.reRunPu) : "",
  rerunBU: usage.reRunBu ? String(usage.reRunBu) : "",
  wastePU: usage.wastagePu ? String(usage.wastagePu) : "",
  wasteBU: usage.wastageBu ? String(usage.wastageBu) : "",
  remarks: usage.remarks ?? "",
});
const sumQty = (a: string, b: string, c: string) => {
  const n = [a, b, c].map(v => Number(v) || 0).reduce((s, x) => s + x, 0);
  return n === 0 ? "" : String(n);
};

/** Generate Inventory modal body — lists real existing usage rows
 * (`GET .../inventory`) alongside new blank rows, and Save creates new rows
 * / updates changed existing rows for real instead of always starting from
 * one blank row and only ever creating. Deleting an existing (persisted)
 * row calls the real delete endpoint immediately; deleting an unsaved blank
 * row just removes it locally. */
function InventoryModalContent({ entryId, onClose }: { entryId: string; onClose: () => void }) {
  const canUpdateInventory = usePermissions().hasPermission(LP.UPDATE_INVENTORY);
  const { data: existingUsage, isLoading } = useInventoryUsage(entryId);
  const createMutation = useCreateInventoryUsage(entryId);
  const updateMutation = useUpdateInventoryUsage(entryId);
  const deleteMutation = useDeleteInventoryUsage(entryId);

  const [invRows, setInvRows] = useState<InvRow[]>([blankInvRow(1)]);
  const seededRef = useRef(false);
  useEffect(() => {
    if (existingUsage && !seededRef.current) {
      seededRef.current = true;
      setInvRows(
        existingUsage.length
          ? existingUsage.map((usage, i) => usageToInvRow(i + 1, usage))
          : [blankInvRow(1)],
      );
    }
  }, [existingUsage]);

  const [saving, setSaving] = useState(false);
  const [deletingId, setDeletingId] = useState<string | null>(null);

  const nextRowId = () => Math.max(0, ...invRows.map(r => r.id)) + 1;

  const toBody = (r: InvRow): InventoryUsageBody => ({
    inventoryItemId: r.material,
    batchNumber: r.batch || undefined,
    expiryDate: r.expiry || undefined,
    allocatedPu: r.allocPU ? Number(r.allocPU) : undefined,
    allocatedBu: r.allocBU ? Number(r.allocBU) : undefined,
    reRunPu: r.rerunPU ? Number(r.rerunPU) : undefined,
    reRunBu: r.rerunBU ? Number(r.rerunBU) : undefined,
    wastagePu: r.wastePU ? Number(r.wastePU) : undefined,
    wastageBu: r.wasteBU ? Number(r.wasteBU) : undefined,
    remarks: r.remarks || undefined,
  });

  const handleRemoveRow = (row: InvRow) => {
    if (!row.usageId) {
      setInvRows(curr => curr.filter(r => r.id !== row.id));
      return;
    }
    setDeletingId(row.usageId);
    deleteMutation.mutate(row.usageId, {
      onSuccess: () => {
        setInvRows(curr => curr.filter(r => r.id !== row.id));
        toast.success("Inventory row removed");
      },
      onError: (e) => toast.error(getApiErrorMessage(e, "Failed to remove inventory row")),
      onSettled: () => setDeletingId(null),
    });
  };

  const handleSave = async () => {
    const valid = invRows.filter(r => r.material.trim());
    if (!valid.length) { toast.error("Add at least one material row"); return; }
    setSaving(true);
    try {
      // Promise.allSettled (not Promise.all) so one row's failure doesn't hide
      // which rows actually succeeded — reports failures per-row (by S.No)
      // instead of one generic "something failed" toast (TECHNICIAN-REPORTING-
      // GAPS.md Part B #19).
      const results = await Promise.allSettled(
        valid.map((r) =>
          r.usageId
            ? updateMutation.mutateAsync({ usageId: r.usageId, body: toBody(r) })
            : createMutation.mutateAsync(toBody(r)),
        ),
      );
      const failed = results
        .map((result, i) => ({ result, row: valid[i]! }))
        .filter((x): x is { result: PromiseRejectedResult; row: InvRow } => x.result.status === "rejected");

      if (failed.length === 0) {
        toast.success(`Inventory saved (${valid.length} material${valid.length === 1 ? "" : "s"})`);
        onClose();
      } else {
        const succeededCount = valid.length - failed.length;
        const failedRowLabel = failed.map((f) => `#${f.row.id}`).join(", ");
        toast.error(
          succeededCount > 0
            ? `Saved ${succeededCount} of ${valid.length} rows — row${failed.length === 1 ? "" : "s"} ${failedRowLabel} failed`
            : `Failed to save row${failed.length === 1 ? "" : "s"} ${failedRowLabel}`,
        );
      }
    } finally {
      setSaving(false);
    }
  };

  return (
    <>
      <div className="dlg-body space-y-3">
        {isLoading ? (
          <div className="py-10 text-center text-sm text-slate-400">Loading inventory...</div>
        ) : (
          <div className="overflow-x-auto rounded-lg border border-slate-200">
            <table className="w-full text-xs">
              <thead className="bg-blue-50 text-blue-900/70">
                <tr>
                  <th className="px-2 py-2 text-left font-semibold whitespace-nowrap">S.No</th>
                  <th className="px-2 py-2 text-left font-semibold whitespace-nowrap">Inventory Material</th>
                  <th className="px-2 py-2 text-left font-semibold whitespace-nowrap">Batch Number</th>
                  <th className="px-2 py-2 text-left font-semibold whitespace-nowrap">Expiry Date</th>
                  <th className="px-2 py-2 text-right font-semibold whitespace-nowrap">Allocated PU</th>
                  <th className="px-2 py-2 text-right font-semibold whitespace-nowrap">Allocated BU</th>
                  <th className="px-2 py-2 text-right font-semibold whitespace-nowrap">Re-Run PU</th>
                  <th className="px-2 py-2 text-right font-semibold whitespace-nowrap">Re-Run BU</th>
                  <th className="px-2 py-2 text-right font-semibold whitespace-nowrap">Wastage PU</th>
                  <th className="px-2 py-2 text-right font-semibold whitespace-nowrap">Wastage BU</th>
                  <th className="px-2 py-2 text-right font-semibold whitespace-nowrap bg-slate-100">Total PU</th>
                  <th className="px-2 py-2 text-right font-semibold whitespace-nowrap bg-slate-100">Total BU</th>
                  <th className="px-2 py-2 text-left font-semibold whitespace-nowrap">Remarks</th>
                  <th className="px-2 py-2 text-center font-semibold whitespace-nowrap w-10">—</th>
                </tr>
              </thead>
              <tbody className="bg-white">
                {invRows.map((row, i) => {
                  const update = (patch: Partial<InvRow>) => setInvRows(curr => curr.map(r => r.id === row.id ? { ...r, ...patch } : r));
                  return (
                    <tr key={row.id} className="border-t border-slate-100">
                      <td className="px-2 py-1.5">
                        {i + 1}
                        {row.usageId && <div className="text-[9px] font-normal text-slate-400">Saved</div>}
                      </td>
                      <td className="px-2 py-1.5"><Input value={row.material} onChange={e => update({ material: e.target.value })} className="h-7 px-2 text-xs" placeholder="Material" /></td>
                      <td className="px-2 py-1.5"><Input value={row.batch} onChange={e => update({ batch: e.target.value })} className="h-7 px-2 text-xs" placeholder="Batch #" /></td>
                      <td className="px-2 py-1.5"><Input type="date" value={row.expiry} onChange={e => update({ expiry: e.target.value })} className="h-7 px-2 text-xs" /></td>
                      <td className="px-2 py-1.5"><Input type="number" value={row.allocPU} onChange={e => update({ allocPU: e.target.value })} className="h-7 px-2 text-xs text-right" /></td>
                      <td className="px-2 py-1.5"><Input type="number" value={row.allocBU} onChange={e => update({ allocBU: e.target.value })} className="h-7 px-2 text-xs text-right" /></td>
                      <td className="px-2 py-1.5"><Input type="number" value={row.rerunPU} onChange={e => update({ rerunPU: e.target.value })} className="h-7 px-2 text-xs text-right" /></td>
                      <td className="px-2 py-1.5"><Input type="number" value={row.rerunBU} onChange={e => update({ rerunBU: e.target.value })} className="h-7 px-2 text-xs text-right" /></td>
                      <td className="px-2 py-1.5"><Input type="number" value={row.wastePU} onChange={e => update({ wastePU: e.target.value })} className="h-7 px-2 text-xs text-right" /></td>
                      <td className="px-2 py-1.5"><Input type="number" value={row.wasteBU} onChange={e => update({ wasteBU: e.target.value })} className="h-7 px-2 text-xs text-right" /></td>
                      <td className="px-2 py-1.5 text-right font-semibold text-slate-700 bg-slate-50">{sumQty(row.allocPU, row.rerunPU, row.wastePU) || "—"}</td>
                      <td className="px-2 py-1.5 text-right font-semibold text-slate-700 bg-slate-50">{sumQty(row.allocBU, row.rerunBU, row.wasteBU) || "—"}</td>
                      <td className="px-2 py-1.5"><Input value={row.remarks} onChange={e => update({ remarks: e.target.value })} className="h-7 px-2 text-xs" placeholder="Remarks" /></td>
                      <td className="px-2 py-1.5 text-center">
                        <button
                          type="button"
                          aria-label="Remove row"
                          title="Remove row"
                          disabled={invRows.length === 1 || deletingId === row.usageId}
                          onClick={() => handleRemoveRow(row)}
                          className="text-red-500 hover:text-red-700 disabled:opacity-30"
                        >
                          <Trash2 className="h-3.5 w-3.5" />
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
        {canUpdateInventory && <button type="button" onClick={() => setInvRows(curr => [...curr, blankInvRow(nextRowId())])}
          className="flex items-center gap-1.5 rounded-lg border border-dashed border-blue-300 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700 hover:bg-blue-100">
          <Plus className="h-3.5 w-3.5" />Add Material Row
        </button>}
      </div>
      <div className="dlg-footer">
        <Button variant="outline" onClick={onClose} disabled={saving}>Cancel</Button>
        <Button loading={saving} disabled={saving || isLoading || !canUpdateInventory} title={!canUpdateInventory ? "You do not have permission to update inventory" : undefined} onClick={() => void handleSave()}>
          {saving ? "Saving..." : "Save"}
        </Button>
      </div>
    </>
  );
}

function EntryModal({
  open,
  onOpenChange,
  entries,
  leftItems,
  focus,
  scope,
  sourceStatus,
  onFocusChange,
  onUpdateEntry,
  onOpenModal,
  onPrintReportTemplate,
  onPrintAllReports,
  onBulkStatusChange,
  bulkActionPending,
}: {
  open: boolean;
  onOpenChange: (next: boolean) => void;
  entries: TestWiseEntry[];
  leftItems: TestWiseEntry[];
  focus: TestWiseEntry | null;
  scope: EntryScope;
  /** The worklist panel the modal was opened from (a STATUS_TABS value) —
   * drives which status is sorted first on the right side (see
   * PANEL_PRIORITY_STATUS). Typed as string to match the page's `selectedStatus`
   * state; unrecognised values simply apply no prioritisation. */
  sourceStatus: string;
  onFocusChange: (entry: TestWiseEntry, scope: EntryScope) => void;
  onUpdateEntry: (entry: TestWiseEntry) => void;
  onOpenModal: (type: Exclude<ModalType, null>, context?: unknown) => void;
  /** Same template-driven print handlers the worklist row actions use
   * (share the parent's single usePrintTemplate() picker instance instead of
   * mounting a second one in here). */
  onPrintReportTemplate: (row: TestWiseEntry) => void;
  onPrintAllReports: (row: TestWiseEntry) => void;
  /** Real bulk transition — same runBulkAction the worklist's own bulk-action
   * bar and Order Overview's toolbar use, so "Validate All"/"Approve All"/
   * "Publish All" genuinely loop over every matching-status test instead of
   * only acting on the single focused entry. */
  onBulkStatusChange: (rowsToUpdate: TestWiseEntry[], actionKey: BulkActionKey) => void;
  bulkActionPending: boolean;
}) {
  const { hasPermission } = usePermissions();
  const [patientSearch, setPatientSearch] = useState("");
  const [expandedIds, setExpandedIds] = useState<Set<string>>(new Set());
  const [mergedIds, setMergedIds] = useState<Set<string>>(new Set());
  // Which single parameter's Overall Result modal is open right now (icon on
  // its result row) — at most one at a time, across every test in this
  // modal. `entryId` disambiguates the same resultParamId string appearing
  // on two different tests (ids are only unique within one LabTest's params).
  const [overallResultTarget, setOverallResultTarget] = useState<{ entryId: string; resultParamId: string } | null>(null);

  // Fetched via the order-scoped `orderId` filter (every status), NOT the
  // status-filtered worklist page — `entries` only contains rows matching
  // whichever status tab the modal was opened from, so once a Save/Submit/
  // Validate/etc. moves the focused test to a different status, it drops out
  // of `entries` entirely. Fetching by order keeps it visible regardless of
  // status. Used for BOTH scopes now (test scope narrows to just the focused
  // entry below) — previously test scope read straight from `entries` and
  // the focused row would vanish from the modal the moment its status
  // changed out of the opening panel's filter.
  const { data: orderEntries } = useOrderEntries(focus?.orderUuid);
  const baseEntries = useMemo<TestWiseEntry[]>(() => {
    if (!focus) return entries;
    const sameOrder = (e: TestWiseEntry) =>
      focus.orderUuid ? e.orderUuid === focus.orderUuid
        : e.orderId === focus.orderId && e.patientName === focus.patientName;
    const orderScoped = orderEntries && orderEntries.length > 0
      ? orderEntries
      : entries.filter(sameOrder); // fallback while the order fetch is loading or has no UUID
    if (scope === "patient") return orderScoped;
    // Test scope: narrow to just the focused entry, but from the
    // order-scoped (status-filter-immune) source above.
    const match = orderScoped.find((e) => e.id === focus.id);
    return match ? [match] : entries.filter((e) => e.id === focus.id);
  }, [scope, focus, orderEntries, entries]);
  const [localEntries, setLocalEntries] = useState<TestWiseEntry[]>(baseEntries);

  const upsertResultsMutation = useUpsertResultValues();
  const saveMutation = useSaveReport();
  const submitMutation = useSubmitReport();
  const updateContentSectionsMutation = useUpdateContentSections();
  const updateOverallResultMutation = useUpdateOverallResult();
  // Drives whether "Useful For"/"Interpretation" are editable below
  // (Technician Settings → Laboratory Permissions) — independent toggles,
  // both false by default (matches the pre-existing hardcoded behavior).
  const { data: technicianSettings } = useTechnicianSettings();

  // Note counts for the highlight badges on the Order/Sample/Tech Notes
  // buttons below — same real GET /lab-reports/:id/notes source and per-
  // category split OrderOverviewDialog already uses, just anchored on this
  // modal's own focused entry instead of an order-level anchor id.
  const { data: focusOrderNotes } = useLabReportNotes(focus?.id ?? null, "ORDER");
  const { data: focusSampleNotes } = useLabReportNotes(focus?.id ?? null, "SAMPLE");
  const { data: focusTechNotes } = useLabReportNotes(focus?.id ?? null, "TECH");

  /* Mirror upstream `baseEntries` into local state so optimistic input updates
     don't get clobbered by a stale prop. `baseEntries` is the full selected
     order's tests in patient scope (fetched via `useOrderEntries`) or the
     single passed entry in test scope. We deliberately re-sync on every
     change — but the collapse-all reset must happen ONLY when the
     dialog opens, otherwise typing a single character triggers a parent
     re-render that collapses the expanded result row mid-keystroke.
     Bug fix: `baseEntries` is always the *list*-shaped data (quantResults/
     semiResults/qualResults/content-sections empty — only `mergeResultParams`
     fills those in from a detail fetch). This effect also refires right
     after Save/Submit (the mutation invalidates the whole lab-reports cache,
     which refreshes the order fetch too), and it used to blindly overwrite
     `localEntries` wholesale — wiping out an already-merged row's grid back
     to empty and racing with (and sometimes winning against) the
     forceRemerge-triggered re-fetch, leaving the grid stuck on "No result
     parameters configured for this test" after a successful Save. For any
     row already in `mergedIds`, keep its merged fields and only refresh the
     rest (status, TAT, etc.) from the fresh entry — the merged fields get
     updated separately, by `handleDetailMerged`, once the re-fetch lands.

     Exception: a Re-Run always resets a report to "Pending" server-side
     (`resetForRerun` clears every LabReportResultValue) — the only way an
     already-merged row's fresh status becomes "Pending" again. Without this
     check, the stale-preservation logic above would keep showing the old
     (now backend-deleted) quant/qual results after a Re-Run, since nothing
     else re-triggers `handleDetailMerged` for a row the technician doesn't
     re-open. Detect that transition and drop the row from `mergedIds` so it
     falls through to the fresh (now-empty) entry instead. */
  useEffect(() => {
    const rerunIds = new Set<string>();
    setLocalEntries((current) => {
      const currentById = new Map(current.map((e) => [e.id, e]));
      return baseEntries.map((fresh) => {
        if (!mergedIds.has(fresh.id)) return fresh;
        const merged = currentById.get(fresh.id);
        if (!merged) return fresh;
        if (fresh.status === "Pending" && merged.status !== "Pending") {
          rerunIds.add(fresh.id);
          // `resetForRerun` only clears LabReportResultValue rows server-side
          // — it never touches usefulFor/interpretation/limitations/remarks/
          // references (see LabReportService.resetForRerun). `fresh` here is
          // the list-shaped baseEntries row, which always hardcodes those 5
          // fields to "" by design (see toTestWiseEntry) since they're only
          // ever filled in by a detail fetch. Returning `fresh` as-is would
          // make a still-valid, still-saved Notes override look wiped out
          // the moment Re-Run flips this row back to Pending, even though
          // nothing was actually lost — it'd just be showing stale/empty
          // display state until the row is re-expanded. Keep `merged`'s
          // Notes fields; only the result grid genuinely needs resetting.
          // Overall Result is likewise untouched by `resetForRerun` (it only
          // clears LabReportResultValue rows) and has no LabTest-level
          // fallback either, so it needs the same preservation as the 5
          // Notes fields above.
          return {
            ...fresh,
            usefulFor: merged.usefulFor,
            interpretation: merged.interpretation,
            limitations: merged.limitations,
            remarks: merged.remarks,
            references: merged.references,
            overallResults: merged.overallResults,
          };
        }
        return {
          ...fresh,
          quantResults: merged.quantResults,
          semiResults: merged.semiResults,
          qualResults: merged.qualResults,
          usefulFor: merged.usefulFor,
          interpretation: merged.interpretation,
          limitations: merged.limitations,
          remarks: merged.remarks,
          references: merged.references,
          overallResults: merged.overallResults,
          mobile: merged.mobile ?? fresh.mobile,
          paymentStatus: merged.paymentStatus ?? fresh.paymentStatus,
          billingType: merged.billingType ?? fresh.billingType,
        };
      });
    });
    if (rerunIds.size > 0) {
      setMergedIds((current) => {
        const next = new Set(current);
        rerunIds.forEach((id) => next.delete(id));
        return next;
      });
    }
  }, [baseEntries, mergedIds]);

  useEffect(() => {
    if (open) {
      setExpandedIds(new Set());
      setMergedIds(new Set());
    }
  }, [open]);

  /* Auto-sync every result row's reference range/value the moment a test is
   * opened (Enter), instead of requiring a manual Sync click per row first.
   * Runs for every parameter regardless of whether it already has a value,
   * so re-opening a test also refreshes a stale reference (matching what
   * clicking Sync manually would do).
   *
   * Bug fix: Quantitative used to call the same narrower `GET
   * /lab-reports/:id/reference-range` resolve endpoint semi/qual still use
   * below — but that endpoint only ever returns `referenceDisplay`, and this
   * function only ever wrote it into `referenceRange`. `handleSync` (the
   * manual Sync button) instead calls the candidates endpoint and picks the
   * first Default-flagged candidate (falling back to the first match), which
   * also carries `unit`/`method`/`referenceRangeId` — so a technician who
   * never clicked Sync manually saw Range AND Unit both blank on open/re-open,
   * only getting them filled in once they clicked Sync themselves. Quantitative
   * here now mirrors `handleSync`'s exact resolution (candidates + isDefault-
   * first) so auto-run and manual Sync always agree and both fields populate
   * without any click. Semi/Qualitative are unchanged (still `getReferenceRange`
   * — see `handleSync`'s own doc comment: no analyzer-scoped candidates exist
   * for those result types). */
  const autoSyncAllReferenceRanges = useCallback(async (entryId: string, merged: TestWiseEntry) => {
    const quantJobs = merged.quantResults.map((r) => ({ kind: "quant" as const, id: r.id }));
    const otherJobs: Array<{ kind: "semi" | "qual"; id: string; method?: string }> = [
      ...merged.semiResults.map((r) => ({ kind: "semi" as const, id: r.id, method: r.method })),
      ...merged.qualResults.map((r) => ({ kind: "qual" as const, id: r.id, method: r.method })),
    ];
    if (quantJobs.length === 0 && otherJobs.length === 0) return;

    // Bug fix: a test with many parameters (e.g. Complete Urine Examination)
    // fires one call per parameter, all in parallel, right after the
    // (heavier) detail fetch that unblocked this — under load, one or two of
    // those N parallel requests can transiently fail (timeout/connection-pool
    // contention), and this used to swallow that silently, leaving that one
    // row's Range blank until the technician noticed and clicked Sync
    // manually. One retry (after a short delay, so it isn't fired
    // back-to-back into the same contention) clears the transient case
    // without any technician action; a job that fails twice is left for
    // Sync, same as before — but only after genuinely retrying once.
    const runQuantJob = async (job: (typeof quantJobs)[number]) => {
      try {
        const { candidates } = await getReferenceRangeCandidates(entryId, job.id);
        const match = candidates.find((c) => c.isDefault) ?? candidates[0];
        if (!match) return { ...job, unit: undefined, method: undefined, display: "", rangeId: undefined };
        return {
          ...job,
          unit: match.unit ?? undefined,
          method: match.method ?? undefined,
          display: match.referenceDisplay ?? "",
          rangeId: match.id,
        };
      } catch {
        return null;
      }
    };
    const runOtherJob = async (job: (typeof otherJobs)[number]) => {
      try {
        const range = await getReferenceRange(entryId, { resultParamId: job.id, methodology: job.method });
        return { ...job, display: range.referenceDisplay ?? "" };
      } catch {
        return null;
      }
    };
    const withRetry = async <T,>(job: T, run: (job: T) => Promise<unknown>) => {
      const first = await run(job);
      if (first) return first;
      await new Promise((r) => setTimeout(r, 400));
      return run(job);
    };
    const [resolvedQuant, resolvedOther] = await Promise.all([
      Promise.all(quantJobs.map((job) => withRetry(job, runQuantJob))),
      Promise.all(otherJobs.map((job) => withRetry(job, runOtherJob))),
    ]);

    setLocalEntries((current) => current.map((item) => {
      if (item.id !== entryId) return item;
      let next = item;
      for (const r of resolvedQuant as Array<Awaited<ReturnType<typeof runQuantJob>>>) {
        if (!r) continue;
        next = {
          ...next,
          quantResults: next.quantResults.map((q) => q.id === r.id ? {
            ...q,
            referenceRange: r.display,
            unit: r.unit ?? q.unit,
            method: r.method ?? q.method,
            referenceRangeId: r.rangeId ?? q.referenceRangeId,
          } : q),
        };
      }
      for (const r of resolvedOther as Array<Awaited<ReturnType<typeof runOtherJob>>>) {
        if (!r) continue;
        if (r.kind === "semi") {
          next = { ...next, semiResults: next.semiResults.map((s) => s.id === r.id ? { ...s, referenceValue: r.display } : s) };
        } else {
          next = { ...next, qualResults: next.qualResults.map((q) => q.id === r.id ? { ...q, referenceValue: r.display } : q) };
        }
      }
      return next;
    }));
  }, []);

  // Must run on every render, before the `!focus` early return below —
  // conditionally skipping a hook call changes the hook count between
  // renders and crashes React ("Rendered more hooks than during the
  // previous render").
  const handleDetailMerged = useCallback((entryId: string, detail: ApiLabReportDetail) => {
    setMergedIds((current) => new Set(current).add(entryId));
    const source = localEntries.find((item) => item.id === entryId);
    if (!source) return;
    const merged = mergeResultParams(source, detail);
    setLocalEntries((current) => current.map((item) => (item.id === entryId ? merged : item)));
    void autoSyncAllReferenceRanges(entryId, merged);
  }, [localEntries, autoSyncAllReferenceRanges]);

  /* Bug fix: `ResultEntryFetcher` only ever fetches a row's detail the FIRST
   * time it's expanded (it unmounts for good once the row joins `mergedIds`,
   * see the render below). That's fine for a row a technician expands, edits,
   * and saves once — but if the row is collapsed and later re-expanded (e.g.
   * to check on it again), the grid was showing whatever was merged at that
   * first expand, forever — never picking up a result an instrument wrote via
   * `/emi/submitResult` in the meantime. Worse, that stale value would then be
   * the one re-sent (and persisted as MANUAL) on the next Save, silently
   * discarding the real adapter-submitted result.
   *
   * Fix: re-fetch and re-merge (same shape as `handleDetailMerged` above) on
   * every collapsed->expanded transition for a row that's been merged before
   * — never while it's already open (no polling, no refetch on every
   * render), so there's never a moment where in-progress, unsaved keystrokes
   * in an open grid get overwritten. A row being expanded for the very first
   * time is left to the existing `ResultEntryFetcher` mount below
   * (re-triggering a fetch here too would just be a harmless, redundant
   * second fetch, so it's skipped via the `mergedIds` check instead). */
  const prevExpandedIdsRef = useRef<Set<string>>(new Set());
  useEffect(() => {
    const prev = prevExpandedIdsRef.current;
    for (const id of expandedIds) {
      if (!prev.has(id) && mergedIds.has(id)) {
        void getLabReport(id).then((detail) => {
          let merged: TestWiseEntry | null = null;
          setLocalEntries((current) => current.map((item) => {
            if (item.id !== id) return item;
            merged = mergeResultParams(item, detail);
            return merged;
          }));
          // Same reference-range auto-sync `handleDetailMerged` runs on a
          // first-time merge — needed here too, or a re-expand would show the
          // freshly re-merged observed value (the fix above) but a stale/blank
          // Range until the technician clicked Sync manually.
          if (merged) void autoSyncAllReferenceRanges(id, merged);
        });
      }
    }
    prevExpandedIdsRef.current = expandedIds;
  }, [expandedIds, mergedIds, autoSyncAllReferenceRanges]);

  if (!focus) return null;

  // Patient scope shows ALL of the selected order's tests (keyed on the order,
  // NOT the patient — a patient's other orders never bleed in). Test scope is
  // the single clicked test.
  const sameOrder = (entry: TestWiseEntry) =>
    focus.orderUuid ? entry.orderUuid === focus.orderUuid
      : entry.orderId === focus.orderId && entry.patientName === focus.patientName;
  const focusedSetBase = scope === "patient"
    ? localEntries.filter(sameOrder)
    : localEntries.filter((entry) => entry.id === focus.id);
  // Ordering follows the source panel: the panel's priority status floats to the
  // top (e.g. Pending — also for the Partial Pending panel), the rest keep their
  // existing order. "All" (priorityStatus null) applies no prioritisation. A
  // stable sort preserves the within-group order on both sides.
  const priorityStatus =
    (PANEL_PRIORITY_STATUS as Record<string, TestStatus | null>)[sourceStatus] ?? null;
  const focusedSet = priorityStatus
    ? [...focusedSetBase].sort((a, b) => {
        const ra = a.status === priorityStatus ? 0 : 1;
        const rb = b.status === priorityStatus ? 0 : 1;
        return ra - rb;
      })
    : focusedSetBase;

  // `focus` is a snapshot captured when the modal/entry was opened and never
  // re-synced — after a status-changing action, `localEntries` has the fresh
  // status but `focus` still shows what it was at open time. Anywhere the
  // header/sidebar needs the CURRENT status, read it from `localEntries`.
  const liveFocus = localEntries.find((entry) => entry.id === focus.id) ?? focus;

  const actionButtonLabel = (status: TestStatus, entryId?: string) => {
    if (status === "Validation Pending") return "Validate";
    if (status === "Result Done") return "Approve";
    if (status === "Approved") return "Publish";
    if (status === "Published") return "View";
    // Bug fix: this used to return "Edit" for both statuses, but the click
    // handler had no matching case and silently fell through to opening the
    // generic Technician Notes dialog instead — completely mismatched from
    // the label. The worklist's own actionButtons() already established the
    // correct action here: "Resubmit" (POST /resubmit, the only real backend
    // transition allowed from these two statuses, returning the report to
    // Validation Pending) — matched here for consistency.
    if (status === "Error Reported" || status === "Result Rejected") return "Resubmit";
    return entryId && expandedIds.has(entryId) ? "Collapse" : "Enter";
  };

  /** The COMPLETE worklist row action set for one entry's current status,
   * gated by the SAME status/permission/lock rules as the worklist's
   * actionButtons() — e.g. Reject only on Validation Pending, Error Reported
   * only on Approved/Published, Trend only on Result Done/Approved/Published,
   * Re-run on every status except Pending/Partial Pending. Rendered in TWO
   * places per request: right after the collapsed row's action button, and
   * again after Save/Submit/Validate/Approve/Publish in the expanded
   * result-entry footer — both call this one function so the two stay in
   * sync automatically instead of drifting apart. */
  const renderStatusActionIcons = (entry: TestWiseEntry) => {
    const canEditEntry = hasPermission(LP.EDIT_REPORT);
    const canRejectEntry = hasPermission(LP.MARK_RESULT_REJECTED);
    const canErrorEntry = hasPermission(LP.MARK_ERROR_REPORTED);
    const canNotesEntry = hasPermission(LP.UPDATE_TECH_NOTES);
    const canRerunEntry = hasPermission(LP.MARK_RE_RUN);
    const canTrendEntry = hasPermission(LP.VIEW_TREND_REPORT);
    const showPrint = !["Pending", "Partial Pending"].includes(entry.status);
    const showEdit = canEditEntry && ["Validation Pending", "Result Done", "Approved"].includes(entry.status);
    const showReject = canRejectEntry && entry.status === "Validation Pending";
    const showError = canErrorEntry && ["Approved", "Published"].includes(entry.status);
    const showRerun = canRerunEntry && !["Pending", "Partial Pending"].includes(entry.status);
    const showTrend = canTrendEntry && ["Result Done", "Approved", "Published"].includes(entry.status);
    return (<>
      <button type="button" className="ib" title="Quick View" onClick={() => onOpenModal("sample-overview", entry)}><Eye className="h-3.5 w-3.5" /></button>
      {showEdit && (
        <button type="button" className="ib orange" disabled={entry.isLocked} title={entry.isLocked ? "Edit Report (report is locked)" : "Edit Report"} onClick={() => onOpenModal("edit-report", entry)}><Pencil className="h-3.5 w-3.5" /></button>
      )}
      {showRerun && (
        <button type="button" className="ib red" title="Re-run" onClick={() => onOpenModal("rerun", entry)}><RotateCcw className="h-3.5 w-3.5" /></button>
      )}
      {showTrend && (
        <button type="button" className="ib purple" title="Trend" onClick={() => onOpenModal("trend", entry)}><TrendingUp className="h-3.5 w-3.5" /></button>
      )}
      {showPrint && (
        <button type="button" className="ib" title="Print" onClick={() => onOpenModal("report-view", entry)}><Printer className="h-3.5 w-3.5" /></button>
      )}
      {showReject && (
        <button type="button" className="ib red" disabled={entry.isLocked} title={entry.isLocked ? "Reject (report is locked)" : "Reject"} onClick={() => onOpenModal("reject", entry)}><XCircle className="h-3.5 w-3.5" /></button>
      )}
      {showError && (
        <button type="button" className="ib red" disabled={entry.isLocked} title={entry.isLocked ? "Error Reported (report is locked)" : "Error Reported"} onClick={() => onOpenModal("error", entry)}><AlertTriangle className="h-3.5 w-3.5" /></button>
      )}
      <button type="button" className="ib green" title="Print Report (choose template)" onClick={() => onPrintReportTemplate(entry)}><Printer className="h-3.5 w-3.5" /></button>
      <button type="button" className="ib purple" disabled={!entry.orderUuid} title="Print All Reports (whole order)" onClick={() => onPrintAllReports(entry)}><FileText className="h-3.5 w-3.5" /></button>
      {canNotesEntry && (
        <button type="button" className="ib purple" disabled={entry.isLocked} title={entry.isLocked ? "Technician Notes (report is locked)" : "Technician Notes"} onClick={() => onOpenModal("update-status", entry)}><ListChecks className="h-3.5 w-3.5" /></button>
      )}
      <button type="button" className="ib" title="Audit Trail" onClick={() => onOpenModal("audit", entry)}><ClipboardList className="h-3.5 w-3.5" /></button>
    </>);
  };

  const resultValuesBody = (entry: TestWiseEntry): UpsertResultValuesBody => ({
    values: [
      ...entry.quantResults.map((r) => ({
        resultParamId: r.id,
        // `observedValue || undefined` used to drop a deliberately-cleared
        // field ("" -> undefined) from the request body entirely, which
        // Prisma's upsert then reads as "not touching this field" — an
        // intentional clear silently left the old value in place. Sending
        // "" explicitly lets the backend actually clear it.
        observed1: r.observedValue,
        observed2: r.observedValue2,
        unit: r.unit || undefined,
        methodology: r.method || undefined,
        // Bug fix: the resolved reference range (from Sync/auto-sync-on-Enter)
        // was only ever kept in local UI state, never sent to the backend —
        // Report View/Trend Report read the SAVED `referenceDisplay` snapshot,
        // not this live value, so they always showed "—" even right after a
        // technician had just seen a real range synced on screen.
        referenceRangeId: r.referenceRangeId,
        referenceDisplay: r.referenceRange || undefined,
        // Calculated parameters are recomputed authoritatively by the backend
        // unless flagged as a manual override (then the sent value sticks).
        isManualOverride: r.isCalculated ? !!r.isOverride : undefined,
      })),
      // Bug fix: semiResults was never included here — it was always empty
      // before mergeResultParams started routing SEMI_QUANTITATIVE params to
      // their own array (see lab-report-adapter.ts), so there was never
      // anything to send. Now that real rows land here, Save/Submit must
      // actually persist them too, same shape as qualResults below.
      ...entry.semiResults.map((r) => ({
        resultParamId: r.id,
        observed1: r.observedValue,
        observed2: r.observedValue2,
        methodology: r.method || undefined,
        referenceRangeId: r.referenceRangeId,
        referenceDisplay: r.referenceValue || undefined,
      })),
      ...entry.qualResults.map((r) => ({
        resultParamId: r.id,
        observed1: r.observedValue,
        methodology: r.method || undefined,
        referenceRangeId: r.referenceRangeId,
        referenceDisplay: r.referenceValue || undefined,
      })),
    ],
  });

  /* Bug fix: after Save/Submit, the whole lab-reports query cache is
   * invalidated and `entries` re-syncs `localEntries` from the fresh
   * *list*-shaped data (quantResults/qualResults always empty there — only
   * `mergeResultParams` fills those in from a detail fetch). The row's id was
   * already in `mergedIds` from the FIRST time it was expanded, so simply
   * dropping it and waiting for `ResultEntryFetcher` to remount was flaky —
   * `invalidateQueries` only refetches a query while it's actively mounted,
   * and toggling `mergedIds` off/on within the same update batch could flip
   * back before the fetcher ever committed, so it never re-fired at all. The
   * grid was then left permanently stuck on "No result parameters configured
   * for this test" after a successful Save/Submit, even though the values
   * were saved correctly. Fetching the fresh detail directly here — instead
   * of relying on a mount/unmount side effect — re-merges deterministically
   * every time, independent of React's render/commit timing. */
  const refetchAndMerge = async (entryId: string) => {
    const detail = await getLabReport(entryId);
    setMergedIds((current) => new Set(current).add(entryId));
    setLocalEntries((current) => current.map((item) => {
      if (item.id !== entryId) return item;
      return mergeResultParams(item, detail);
    }));
  };

  const handleSaveResults = async (entry: TestWiseEntry) => {
    try {
      await upsertResultsMutation.mutateAsync({ id: entry.id, body: resultValuesBody(entry) });
      await saveMutation.mutateAsync(entry.id);
      await refetchAndMerge(entry.id);
      toast.success("Results saved");
    } catch (err) {
      // Bug fix: this used to swallow the real backend reason (e.g.
      // LAB_REPORT_SAMPLE_MISSING, LAB_REPORT_RESULTS_REQUIRED) behind a
      // generic "Failed to save results" — a technician had no way to know
      // *why* it failed. getApiErrorMessage surfaces the backend's actual
      // `error.message` when available, falling back to the old generic
      // text only if none exists.
      toast.error(getApiErrorMessage(err, "Failed to save results"));
    }
  };

  const handleSubmitResults = async (entry: TestWiseEntry) => {
    try {
      await upsertResultsMutation.mutateAsync({ id: entry.id, body: resultValuesBody(entry) });
      await submitMutation.mutateAsync(entry.id);
      await refetchAndMerge(entry.id);
      toast.success("Results submitted");
    } catch (err) {
      toast.error(getApiErrorMessage(err, "Failed to submit results"));
    }
  };

  /** "Sync" pulls the real reference range for a parameter — there is no
   * real equipment-integration endpoint to sync observed values from.
   *
   * Quantitative uses the same candidates list the Range dropdown does (`GET
   * /lab-reports/:id/reference-range/candidates`) rather than the older,
   * narrower resolve endpoint — that endpoint only ever returned
   * `{ referenceRangeId, referenceDisplay }`, so Sync could never set
   * Unit/Method the way picking a Range manually does. Applies the first
   * Default-marked candidate (falling back to the first match if none is
   * flagged default), same rule as RangeSelect's own auto-select.
   *
   * Semi-Quantitative/Qualitative keep the original age/gender/methodology-
   * aware resolve endpoint — they have no analyzer-scoped candidates to list
   * (see the candidates endpoint's own doc comment), so there's nothing for
   * them to gain from the newer endpoint. */
  const handleSync = async (
    entry: TestWiseEntry,
    resultParamId: string,
    methodology: string | undefined,
    kind: "quant" | "semi" | "qual",
  ) => {
    try {
      if (kind === "quant") {
        const { candidates } = await getReferenceRangeCandidates(entry.id, resultParamId);
        const match = candidates.find((c) => c.isDefault) ?? candidates[0];
        if (!match) {
          toast.error("No matching reference range configured for this patient");
          return;
        }
        const next = {
          ...entry,
          quantResults: entry.quantResults.map((item) => item.id === resultParamId ? {
            ...item,
            unit: match.unit ?? item.unit,
            method: match.method ?? item.method,
            referenceRange: match.referenceDisplay ?? "",
            referenceRangeId: match.id,
          } : item),
        };
        setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
        onUpdateEntry(next);
        toast.success("Reference range synced");
        return;
      }

      const range = await getReferenceRange(entry.id, { resultParamId, methodology });
      const next = {
        ...entry,
        semiResults: kind === "semi"
          ? entry.semiResults.map((item) => item.id === resultParamId ? { ...item, referenceValue: range.referenceDisplay ?? "", referenceRangeId: range.referenceRangeId ?? undefined } : item)
          : entry.semiResults,
        qualResults: kind === "qual"
          ? entry.qualResults.map((item) => item.id === resultParamId ? { ...item, referenceValue: range.referenceDisplay ?? "", referenceRangeId: range.referenceRangeId ?? undefined } : item)
          : entry.qualResults,
      };
      setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
      onUpdateEntry(next);
      toast.success("Reference range synced");
    } catch {
      toast.error("Failed to sync reference range");
    }
  };

  /* One merged table per test — every parameter together in its original
   * order, regardless of result type (Quantitative/Semi-Quantitative/
   * Qualitative), matching the mockup's single "Chemical Examination (N
   * parameters)" layout. Previously this rendered 3 SEPARATE tables (one per
   * result type, each only appearing when non-empty) — moved to a single
   * discriminated-union row renderer instead so a multi-type test (e.g.
   * Complete Urine Examination: quant + semi-quant + qual parameters) reads
   * as one coherent list top-to-bottom rather than 3 disconnected boxes. */
  const resultBlock = (entry: TestWiseEntry) => {
    type Row =
      | { kind: "quant"; result: QuantResult }
      | { kind: "semi"; result: SemiResult }
      | { kind: "qual"; result: QualResult };
    // Merge all three result-type arrays into one list ordered by
    // `createdAt` (when the parameter was added to the test), not grouped by
    // result-type — quant/semi/qual params interleave in the order they were
    // added. A row with no `createdAt` (older data predating this field)
    // sorts last within its tie rather than crashing the sort.
    const allRows: Row[] = [
      ...entry.quantResults.map((result): Row => ({ kind: "quant", result })),
      ...entry.semiResults.map((result): Row => ({ kind: "semi", result })),
      ...entry.qualResults.map((result): Row => ({ kind: "qual", result })),
    ].sort((a, b) => {
      const at = a.result.createdAt ? Date.parse(a.result.createdAt) : Infinity;
      const bt = b.result.createdAt ? Date.parse(b.result.createdAt) : Infinity;
      return at - bt;
    });

    if (allRows.length === 0) {
      return (
        <div className="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-3 text-center text-xs text-slate-400">
          No result parameters configured for this test.
        </div>
      );
    }

    /* Group parameters by their admin-configured `LabTestResultParam
     * .groupName` (e.g. "Chemical Examination") into collapsible sections,
     * matching Master Data's own grouping — a parameter with no groupName
     * falls into "Ungrouped", shown last after every named group. Groups are
     * otherwise in first-appearance order (which is add-time order, since
     * `allRows` above is already sorted by `createdAt`); rows within a group
     * inherit that same add-time order. */
    const UNGROUPED = "Ungrouped";
    const groupOrder: string[] = [];
    const rowsByGroup = new Map<string, Row[]>();
    for (const row of allRows) {
      const name = row.result.groupName?.trim() || UNGROUPED;
      if (!rowsByGroup.has(name)) {
        groupOrder.push(name);
        rowsByGroup.set(name, []);
      }
      rowsByGroup.get(name)!.push(row);
    }
    if (rowsByGroup.has(UNGROUPED)) {
      groupOrder.splice(groupOrder.indexOf(UNGROUPED), 1);
      groupOrder.push(UNGROUPED);
    }

    /* Sr | Parameter | Result Type | Observed 1 | Observed 2 | Range | Unit
     * | Method | Reference Value | Sync | Overall Result. No Date column —
     * this table is per-test (the order date is already shown once in the
     * header strip above), not per-row. Sr/Sync/Overall Result stay
     * fixed-width; every other column is a `minmax` sized off ITS OWN real
     * content, not an even `fr` split (that's what produced the earlier
     * "clogged" layout — Range/Unit got wide slots for values that render as
     * short truncated/placeholder text, leaving visible dead space, while
     * Result Type's longest label, "Semi-Quantitative", didn't fit its slot
     * and truncated). Range is the widest of the bunch (220px min) since its
     * "Adapter · Method · Unit · Range" label is the longest content any
     * column here renders — RangeSelect's trigger has its own explicit
     * `overflow-hidden`/`truncate` (the base SelectTrigger's `line-clamp-1`
     * only clamps a direct `<span>` child, not the icon+text span one level
     * deeper that the Star marker needs), so a label that still doesn't fit
     * ellipsizes on one line instead of wrapping and bleeding into the row
     * below. The template's total min-width (see the wrapping
     * `overflow-x-auto` div below) is wider than most viewports on purpose —
     * columns scroll horizontally rather than being squeezed unreadably
     * thin. The Overall Result icon (last column) only renders for a row
     * whose parameter is tagged into a group — see `overallResultIcon`
     * below. */
    const grid = "grid grid-cols-[20px_minmax(110px,1fr)_minmax(112px,0.85fr)_minmax(90px,0.9fr)_minmax(70px,0.7fr)_minmax(220px,1.6fr)_minmax(52px,0.45fr)_minmax(96px,0.75fr)_minmax(96px,0.8fr)_28px_28px] items-center gap-2 text-xs min-w-[1070px]";
    // A row's icon only shows when this specific parameter is tagged into at
    // least one Overall Result group — per-parameter, not per-test (see
    // OverallResultModal's doc comment). Renders a spacer of the same width
    // when not eligible so every row in the column still lines up.
    const overallResultIcon = (result: { id: string; overallResultGroups?: string[] }) => {
      if (!result.overallResultGroups?.length) return <div />;
      const applied = entry.overallResults[result.id];
      return (
        <button
          type="button"
          className="ib"
          title="Overall Result"
          aria-label="Overall Result"
          onClick={() => setOverallResultTarget({ entryId: entry.id, resultParamId: result.id })}
        >
          <ScrollText className={cn("h-3.5 w-3.5", applied?.content && "text-blue-600")} />
        </button>
      );
    };

    const renderRow = (row: Row, index: number) => {
            if (row.kind === "quant") {
              const result = row.result;
              return (
                <div key={result.id} className={grid}>
                  <div>{index + 1}</div>
                  <div className="font-medium text-slate-800 truncate" title={result.resultName}>
                    {result.resultName}
                    {result.isCalculated && <span className="ml-1 text-[9px] font-semibold uppercase text-violet-500" title={result.formula ? `= ${result.formula}` : "Calculated"}>ƒx</span>}
                  </div>
                  {/* Read-only — the parameter's configured result type
                      (LabTestResultParam.resultType), not editable from Test
                      Entry. Which array a row came from (set in
                      mergeResultParams) already tells us this — no separate
                      stored field needed here. */}
                  <div className="text-[11px] text-slate-500 truncate">Quantitative</div>
                  {/* Observed 1 — calculated params show the auto-computed value
                      (disabled) unless manually overridden; measured params also
                      trigger a live recompute of any dependent calculated params.
                      Suggestions (when configured on the parameter) show as a
                      typeahead dropdown while typing — picking one or typing a
                      brand-new value both commit the same way. */}
                  <div title={result.isCalculated && result.formula ? `= ${result.formula}` : undefined}>
                    <AutosuggestInput
                      value={result.observedValue}
                      disabled={!!result.isCalculated && !result.isOverride}
                      suggestions={result.resultSuggestions ?? []}
                      onChange={(v) => {
                        const updated = entry.quantResults.map((item) => item.id === result.id ? { ...item, observedValue: v } : item);
                        const next = { ...entry, quantResults: recomputeCalculatedResults(updated) };
                        setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
                        onUpdateEntry(next);
                      }}
                      className={cn("h-7 px-2 text-xs", result.isCalculated && !result.isOverride && "bg-slate-50 text-slate-500")}
                    />
                  </div>
                  {result.isCalculated ? (
                    // Observed 2 slot repurposed as the override toggle for a calculated param.
                    <button
                      type="button"
                      className="ib"
                      title={result.isOverride ? "Reset to formula" : "Edit (manual override)"}
                      aria-label={result.isOverride ? "Reset to formula" : "Edit (manual override)"}
                      onClick={() => {
                        const updated = entry.quantResults.map((item) => item.id === result.id ? { ...item, isOverride: !item.isOverride } : item);
                        const next = { ...entry, quantResults: recomputeCalculatedResults(updated) };
                        setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
                        onUpdateEntry(next);
                      }}
                    >
                      {result.isOverride ? <RotateCcw className="h-3.5 w-3.5" /> : <Pencil className="h-3.5 w-3.5" />}
                    </button>
                  ) : (
                    <Input value={result.observedValue2 ?? ""} onChange={(event) => {
                      const next = { ...entry, quantResults: entry.quantResults.map((item) => item.id === result.id ? { ...item, observedValue2: event.target.value } : item) };
                      setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
                      onUpdateEntry(next);
                    }} className="h-7 px-2 text-xs" />
                  )}
                  <RangeSelect
                    reportId={entry.id}
                    resultParamId={result.id}
                    value={result.referenceRangeId}
                    onSelect={(candidate) => {
                      // Picking a different range invalidates an LIS-
                      // transferred value: it was measured against the
                      // PREVIOUS range's method/unit, not this one — clearing
                      // it (rather than silently keeping a mismatched number)
                      // forces a re-transfer or manual re-entry.
                      const wasAdapterSourced = result.source === "ADAPTER";
                      const next = {
                        ...entry,
                        quantResults: entry.quantResults.map((item) => item.id === result.id ? {
                          ...item,
                          unit: candidate.unit ?? item.unit,
                          method: candidate.method ?? item.method,
                          referenceRange: candidate.referenceDisplay ?? "",
                          referenceRangeId: candidate.id,
                          ...(wasAdapterSourced ? { observedValue: "", observedValue2: "", source: undefined } : {}),
                        } : item),
                      };
                      setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
                      onUpdateEntry(next);
                      if (wasAdapterSourced) {
                        toast.warning(`Range changed — cleared the LIS-transferred result for ${result.resultName}. Re-transfer from the analyser or enter manually.`);
                      }
                    }}
                  />
                  <div className="px-1 text-[11px] text-slate-500 truncate" title={result.unit || ""}>{result.unit || "—"}</div>
                  {/* Method is derived from the picked Range (RangeSelect
                      above sets it), not independently editable — read-only
                      display instead of a dropdown. */}
                  <div className="px-1 text-[11px] text-slate-500 truncate" title={result.method || ""}>{result.method || "—"}</div>
                  {/* Reference Value doesn't apply to Quantitative — that
                      concept only exists for a categorical (Semi-Quant/Qual)
                      result; Quantitative uses Reference Range instead. */}
                  <div className="px-1 text-[11px] text-slate-400 truncate">—</div>
                  <button type="button" className="ib" title="Sync" aria-label="Sync" onClick={() => handleSync(entry, result.id, result.method, "quant")}><RefreshCw className="h-3.5 w-3.5" /></button>
                  {overallResultIcon(result)}
                </div>
              );
            }

            if (row.kind === "semi") {
              const result = row.result;
              return (
                <div key={result.id} className={grid}>
                  <div>{index + 1}</div>
                  <div className="font-medium text-slate-800 truncate" title={result.resultName}>{result.resultName}</div>
                  <div className="text-[11px] text-slate-500 truncate">Semi-Quantitative</div>
                  {/* Datalist-style: shows the configured options (Negative/
                      Trace/+/++/+++) plus this parameter's own configured
                      Result Suggestions (Master Data > Add Test > Results)
                      as a filtered suggestion list, but any typed value
                      commits directly — same free-text-plus-suggestions
                      pattern as Quantitative's Observed 1, not a closed
                      dropdown. */}
                  <AutosuggestInput
                    value={result.observedValue}
                    suggestions={[...new Set([...SEMI_RESULT_OPTIONS, ...(result.resultSuggestions ?? [])])]}
                    onChange={(value) => {
                      const next = { ...entry, semiResults: entry.semiResults.map((item) => item.id === result.id ? { ...item, observedValue: value } : item) };
                      setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
                      onUpdateEntry(next);
                    }}
                    className="h-7 px-2 text-xs"
                  />
                  {/* Free-text secondary reading (e.g. a repeat/duplicate),
                      same input as Quantitative's Observed 2 — optional, most
                      Semi-Quantitative parameters never use it. */}
                  <Input value={result.observedValue2 ?? ""} onChange={(event) => {
                    const next = { ...entry, semiResults: entry.semiResults.map((item) => item.id === result.id ? { ...item, observedValue2: event.target.value } : item) };
                    setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
                    onUpdateEntry(next);
                  }} className="h-7 px-2 text-xs" />
                  {/* Reference Range doesn't apply — Semi-Quantitative uses
                      Reference Value (a single expected label) instead. */}
                  <div className="px-1 text-[11px] text-slate-400">—</div>
                  {/* Unit doesn't apply to Semi-Quantitative. */}
                  <div className="px-1 text-[11px] text-slate-400">—</div>
                  {/* Method comes from the parameter's own configuration
                      (LabTestResultParam.method), same as Quantitative — not
                      independently choosable, so read-only display instead
                      of a dropdown (there's no Range picker to derive it from
                      here, unlike Quantitative, since Semi-Quantitative has
                      no analyzer-scoped reference values yet). */}
                  <div className="px-1 text-[11px] text-slate-500 truncate" title={result.method || ""}>{result.method || "—"}</div>
                  <div className="px-1 text-[11px] font-semibold text-green-600 truncate" title={result.referenceValue ?? ""}>{result.referenceValue || "—"}</div>
                  <button type="button" className="ib" title="Sync" aria-label="Sync" onClick={() => handleSync(entry, result.id, result.method, "semi")}><RefreshCw className="h-3.5 w-3.5" /></button>
                  {overallResultIcon(result)}
                </div>
              );
            }

            const result = row.result;
            return (
              <div key={result.id} className={grid}>
                <div>{index + 1}</div>
                <div className="font-medium text-slate-800 truncate" title={result.resultName}>{result.resultName}</div>
                <div className="text-[11px] text-slate-500 truncate">Qualitative</div>
                {/* Spans Observed 1 through Reference Value (6 columns) —
                    matches the original mockup, where a Qualitative row's
                    value is the only thing shown between Result Type and
                    Sync: no Unit, Method, Reference Range, or Reference Value
                    columns for this row type. Datalist-style: configured
                    options (Positive/Negative/etc.) plus this parameter's own
                    configured Result Suggestions show as filtered
                    suggestions, but any typed value commits directly, same as
                    Quantitative's Observed 1 — not a closed dropdown. */}
                <div className="col-span-6">
                  <AutosuggestInput
                    value={result.observedValue}
                    suggestions={[...new Set([...QUAL_RESULT_OPTIONS, ...(result.resultSuggestions ?? [])])]}
                    placeholder="Type or select…"
                    onChange={(value) => {
                      const next = { ...entry, qualResults: entry.qualResults.map((item) => item.id === result.id ? { ...item, observedValue: value } : item) };
                      setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
                      onUpdateEntry(next);
                    }}
                    className="h-7 px-2 text-xs"
                  />
                </div>
                <button type="button" className="ib" title="Sync" aria-label="Sync" onClick={() => handleSync(entry, result.id, result.method, "qual")}><RefreshCw className="h-3.5 w-3.5" /></button>
                {overallResultIcon(result)}
              </div>
      );
    };

    return (
      <div className="space-y-2">
        {groupOrder.map((groupName, groupIndex) => {
          const groupRows = rowsByGroup.get(groupName)!;
          // First group open by default (matches the mockup: "Chemical
          // Examination" expanded, later groups collapsed) — every group
          // remains independently togglable via <details>'s own state.
          return (
            <details key={groupName} className="group rounded-xl border border-slate-200 bg-white" open={groupIndex === 0}>
              {/* `flex` on <summary> suppresses the browser's native
                  disclosure triangle in most browsers, so this uses an
                  explicit chevron instead (same as the rest of this
                  codebase's collapsible sections) — rotated open/closed via
                  the `group-open:` variant rather than JS state, since
                  <details> already tracks that natively. */}
              <summary className="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2.5 text-sm font-semibold text-slate-700 [&::-webkit-details-marker]:hidden">
                <span className="flex items-center gap-2">
                  <ChevronRight className="h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform group-open:rotate-90" />
                  {groupName} <span className="font-normal text-slate-400">({groupRows.length} parameter{groupRows.length === 1 ? "" : "s"})</span>
                </span>
              </summary>
              <div className="border-t border-slate-100 p-3">
                <div className="overflow-x-auto">
                  <div className={cn(grid, "text-[10px] font-semibold uppercase tracking-wide text-slate-500")}>
                    <div>Sr</div><div>Parameter</div><div>Result Type</div><div>Observed 1</div><div>Observed 2</div><div>Range</div><div>Unit</div><div>Method</div><div>Reference Value</div><div>Sync</div>
                  </div>
                  <div className="space-y-1.5 pt-1.5">
                    {groupRows.map((row, index) => renderRow(row, index))}
                  </div>
                </div>
              </div>
            </details>
          );
        })}
      </div>
    );
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="h-[92vh] max-w-[96vw] overflow-hidden p-0 flex flex-col">
        <DialogTitle className="sr-only">{scope === "patient" ? "Patient Entry" : "Test Entry"} — {focus.patientName}</DialogTitle>
        <div className="flex h-full flex-col">
          <div className="dlg-head flex items-center justify-between pr-14">
            <div>
              <div className="dlg-title">{scope === "patient" ? "Patient Entry" : "Test Entry"} — {focus.patientName}</div>
              <div className="dlg-sub">{liveFocus.status} • {focus.orderId}</div>
            </div>
            <Button variant="ghost" size="sm" onClick={() => onOpenChange(false)} className="text-white/80 hover:text-white hover:bg-white/10">Close</Button>
          </div>
          <div className="grid min-h-0 flex-1 grid-cols-[220px_minmax(0,1fr)] overflow-hidden h-[calc(92vh-64px)]">
            <div className="border-r border-slate-200 bg-slate-50/50 p-3 flex flex-col min-h-0">
              <div className="text-[10px] font-semibold uppercase tracking-wide text-slate-400">{scope === "patient" ? "Patient List" : "Next Test Entry"}</div>
              <div className="relative mt-3">
                <Search className="absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-slate-400" />
                <Input value={patientSearch} onChange={(event) => setPatientSearch(event.target.value)} className="h-8 pl-8 text-xs" placeholder="Search name, test, order, UMID" />
              </div>
              <div className="mt-3 flex-1 overflow-y-auto max-h-[calc(92vh-160px)] space-y-2 pr-1">
                {leftItems
                  .filter((entry) => [entry.patientName, entry.testName, entry.orderId, entry.umiId].join(" ").toLowerCase().includes(patientSearch.toLowerCase()))
                  .map((staleEntry) => {
                    // `leftItems` is a snapshot captured when the modal opened and
                    // never refreshed — read the live status from `localEntries`
                    // (same fix as `liveFocus` above) so a Save/Submit/Validate/
                    // Approve action is reflected here immediately, not just on the
                    // row inside the expanded view.
                    const entry = localEntries.find((item) => item.id === staleEntry.id) ?? staleEntry;
                    return (
                    <button key={entry.id} type="button" onClick={() => onFocusChange(entry, scope)} className={cn("w-full rounded-xl border px-3 py-2 text-left", entry.id === focus.id ? "border-blue-500 bg-blue-50 ring-2 ring-blue-200" : "border-slate-200 bg-white hover:bg-slate-50")}>
                      <div className="text-sm font-semibold text-slate-800">{scope === "patient" ? entry.patientName : entry.testName}</div>
                      <div className="text-[11px] font-medium text-slate-600">{scope === "patient" ? entry.orderId : `${entry.patientName} · ${entry.orderId}`}</div>
                      {scope === "patient" && <div className="text-[11px] text-slate-500">{`${entry.umiId} · ${entry.patientAge}y / ${entry.patientGender}`}</div>}
                      <div className="mt-1"><StatusBadge value={entry.status} /></div>
                    </button>
                    );
                  })}
              </div>
            </div>
            <div className="overflow-y-auto bg-white p-4">
              {/* ── Order Console-style patient details card ── */}
              <div className="bg-white rounded-xl border border-gray-200 shadow-sm px-6 py-5">
                <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-4">
                  {/* Bug fix: this card used to read straight off `focus` —
                      Mobile/Payment Status/Billing Type only ever arrive via
                      the detail-merge (see `mergeResultParams`), never on the
                      raw worklist-list row `focus` is initialized from, so
                      they showed blank until the SAME fetch that already
                      feeds `liveFocus` (used above for the header/sidebar
                      status) had landed. Reading `liveFocus` here instead
                      picks up the merged values the moment they arrive,
                      exactly like the status text already does. */}
                  {([
                    ["Order No", focus.orderId],
                    ["Patient Name", focus.patientName],
                    ["UHID", focus.umiId],
                    ["Age / Gender", `${focus.patientAge}Y / ${focus.patientGender}`],
                    ["Mobile", liveFocus.mobile ?? "—"],
                    ["Branch", focus.branch],
                    ["Ref Panel", focus.refPanel],
                    ["Ref By", focus.refBy],
                    ["Order Mode", focus.isOutsourced ? "Outsource" : "Walk-in"],
                    ["Payment Status", liveFocus.paymentStatus
                      ? <StatusBadge key="ps" value={PAYMENT_STATUS_LABEL[liveFocus.paymentStatus] ?? liveFocus.paymentStatus} />
                      : "—"],
                    ["Billing Type", liveFocus.billingType ?? "—"],
                    ["Order Date", focus.orderDate],
                  ] as Array<[string, React.ReactNode]>).map(([label, value]) => (
                    <div key={label as string} className="min-w-0">
                      <div className="text-[10px] font-semibold tracking-wider text-gray-400 uppercase mb-1">{label}</div>
                      <div className="text-sm font-medium text-gray-800 truncate">{value}</div>
                    </div>
                  ))}
                </div>
              </div>
              {/* ── Notes & documents strip (matches Order Console) ── */}
              <div className="mt-3 bg-white rounded-xl border border-gray-200 shadow-sm px-5 py-2 flex items-center justify-start flex-wrap gap-2">
                <button type="button" onClick={() => onOpenModal("notes", { ...focus, notesKind: "ORDER" })}
                  className="relative flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-600 hover:bg-orange-50 hover:text-orange-700 transition-colors">
                  <FileText className="w-4 h-4 text-orange-500" /><span>Order Notes</span>
                  {(focusOrderNotes?.length ?? 0) > 0 && <span className="absolute -top-1 -right-1 min-w-[16px] h-4 px-1 bg-orange-500 text-white rounded-full text-[9px] flex items-center justify-center font-bold">{focusOrderNotes?.length}</span>}
                </button>
                <button type="button" onClick={() => onOpenModal("notes", { ...focus, notesKind: "SAMPLE" })}
                  className="relative flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                  <FlaskConical className="w-4 h-4 text-blue-500" /><span>Sample Notes</span>
                  {(focusSampleNotes?.length ?? 0) > 0 && <span className="absolute -top-1 -right-1 min-w-[16px] h-4 px-1 bg-blue-500 text-white rounded-full text-[9px] flex items-center justify-center font-bold">{focusSampleNotes?.length}</span>}
                </button>
                <button type="button" onClick={() => onOpenModal("notes", { ...focus, notesKind: "TECH" })}
                  className="relative flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-600 hover:bg-purple-50 hover:text-purple-700 transition-colors">
                  <Activity className="w-4 h-4 text-purple-500" /><span>Tech Notes</span>
                  {(focusTechNotes?.length ?? 0) > 0 && <span className="absolute -top-1 -right-1 min-w-[16px] h-4 px-1 bg-purple-500 text-white rounded-full text-[9px] flex items-center justify-center font-bold">{focusTechNotes?.length}</span>}
                </button>
                <button type="button" disabled title="Documents — not yet available"
                  className="flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-400 opacity-60 cursor-not-allowed">
                  <FileText className="w-4 h-4 text-gray-400" /><span>Documents</span>
                </button>
              </div>
              <div className="mt-3 flex items-center justify-end gap-2">
                {(() => {
                  // Each "* All" button is evaluated independently against
                  // the CURRENT full set of tests on this order (not just the
                  // single focused entry that happened to open the modal) —
                  // fixes a real bug where "Approve All" etc. only ever acted
                  // on one report while silently leaving every other
                  // matching-status test in the order untouched. Reuses the
                  // exact same runBulkAction the worklist's own bulk bar and
                  // Order Overview's toolbar call, so the request(s) that go
                  // out are identical to selecting rows there and clicking
                  // the matching bulk button.
                  //
                  // Gated on count: a "* All" button only appears once 2+
                  // tests in this order actually qualify for it — with
                  // exactly 1 (or 0), the per-row action button already
                  // covers it, so showing "All" would be misleading.
                  const entryable = focusedSet.filter(e => ["Pending", "Partial Pending", "Saved"].includes(e.status));
                  const allExpanded = entryable.length > 0 && entryable.every(e => expandedIds.has(e.id));
                  const validationPendingSet = focusedSet.filter(e => e.status === "Validation Pending");
                  const resultDoneSet = focusedSet.filter(e => e.status === "Result Done");
                  const approvedSet = focusedSet.filter(e => e.status === "Approved");
                  return (<>
                    {validationPendingSet.length > 1 && (
                      <Button size="sm" loading={bulkActionPending} disabled={bulkActionPending} onClick={() => onBulkStatusChange(validationPendingSet, "validate")}>Validate All</Button>
                    )}
                    {resultDoneSet.length > 1 && (
                      <Button size="sm" loading={bulkActionPending} disabled={bulkActionPending} onClick={() => onBulkStatusChange(resultDoneSet, "approve")}>Approve All</Button>
                    )}
                    {approvedSet.length > 1 && (
                      <Button size="sm" loading={bulkActionPending} disabled={bulkActionPending} onClick={() => onBulkStatusChange(approvedSet, "publish")}>Publish All</Button>
                    )}
                    {entryable.length > 1 && (
                      allExpanded
                        ? <Button size="sm" variant="outline" onClick={() => setExpandedIds(new Set())}>Collapse All</Button>
                        : <Button size="sm" variant="outline" onClick={() => setExpandedIds(new Set(entryable.map(e => e.id)))}>Enter All</Button>
                    )}
                  </>);
                })()}
              </div>
              <div className="mt-4 space-y-4">
                {focusedSet.map((entry, index) => {
                  const expanded = expandedIds.has(entry.id);
                  return (
                    <div key={entry.id} className="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" data-status={entry.status}>
                      <div className="grid items-center gap-3 border-b border-slate-100 bg-slate-50 px-4 py-3 md:grid-cols-[24px_120px_auto_auto_1fr]">
                        <div className="text-xs text-slate-500">{index + 1}</div>
                        <div className="text-xs text-slate-500">{entry.orderDate}</div>
                        <div className="min-w-[140px]">
                          <div className="text-sm font-semibold text-slate-800">{entry.testName}</div>
                          <div className="text-[10px] text-slate-400">{entry.testType}</div>
                        </div>
                        <div className="flex flex-nowrap items-center gap-1.5 px-2">
                          {hasPermission(LP.MARK_LOCK_TEST) && <button type="button" className="ib" title="Lock test" onClick={() => onOpenModal("lock-test", entry)}><Shield className="h-3.5 w-3.5" /></button>}
                          {hasPermission(LP.MARK_DELTA_CHECK) && <button type="button" className="ib purple" title="Delta check" onClick={() => onOpenModal("delta-check", entry)}><ArrowLeftRight className="h-3.5 w-3.5" /></button>}
                          {hasPermission(LP.MARK_CRITICAL_ALERT) && <button type="button" className="ib red" title="Critical alert" onClick={() => onOpenModal("critical-alert", entry)}><AlertTriangle className="h-3.5 w-3.5" /></button>}
                          {hasPermission(LP.MARK_OOR) && <button type="button" className="ib orange" title="Out of range alert" onClick={() => onOpenModal("oor-alert", entry)}><Bell className="h-3.5 w-3.5" /></button>}
                          {hasPermission(LP.MARK_RE_RUN) && <button type="button" className="ib purple" title="Re-run request" onClick={() => onOpenModal("rerun", entry)}><RotateCcw className="h-3.5 w-3.5" /></button>}
                          {hasPermission(LP.MARK_SCHEDULED) && <button type="button" className="ib" title="Schedule test" onClick={() => onOpenModal("schedule", entry)}><Calendar className="h-3.5 w-3.5" /></button>}
                          {hasPermission(LP.MARK_MULTISTEP) && <button type="button" className="ib purple" title="Multi step process" onClick={() => onOpenModal("multistep", entry)}><Activity className="h-3.5 w-3.5" /></button>}
                          <button type="button" className="ib" title="Audit trail" onClick={() => onOpenModal("audit", entry)}><FileSearch className="h-3.5 w-3.5" /></button>
                          <button type="button" className="ib green" title="Sample overview" onClick={() => onOpenModal("sample-overview", entry)}><FlaskConical className="h-3.5 w-3.5" /></button>
                          {hasPermission(LP.VIEW_INVENTORY) && <button type="button" className="ib" title="Inventory" onClick={() => onOpenModal("inventory", entry)}><Wrench className="h-3.5 w-3.5" /></button>}
                          {hasPermission(LP.VIEW_TREND_REPORT) && <button type="button" className="ib purple" title="Trend report" onClick={() => onOpenModal("trend", entry)}><TrendingUp className="h-3.5 w-3.5" /></button>}
                        </div>
                        <div className="flex flex-wrap items-center justify-end gap-2 pr-2">
                          <StatusBadge value={entry.status} />
                          <StatusBadge value={entry.sampleStatus} />
                          {(() => {
                            const label = expanded ? "Collapse" : actionButtonLabel(entry.status, entry.id);
                            const isPrimary = !expanded && ["Validate","Approve","Publish"].includes(label);
                            const isResubmit = !expanded && label === "Resubmit";
                            // Toggling expand/collapse is local-only (no
                            // backend call) so it's never gated; only the
                            // status-transition labels are — matches the
                            // main table's lock gating.
                            const isLockGated = !expanded && label !== "Enter" && label !== "Collapse";
                            const canResubmitEntry = hasPermission(LP.ACCESS_RESULT_REJECTED) || hasPermission(LP.ACCESS_ERROR_REPORTED);
                            return (
                              <Button
                                size="sm"
                                variant={isPrimary ? "default" : "outline"}
                                className={isPrimary ? "bg-brand-grad text-white border-transparent" : isResubmit ? "text-orange-700" : undefined}
                                disabled={(isLockGated && entry.isLocked) || (isResubmit && !canResubmitEntry)}
                                title={isResubmit && !canResubmitEntry ? "You do not have permission for this action" : isLockGated && entry.isLocked ? "Report is locked" : undefined}
                                onClick={() => {
                            if (expanded) {
                              setExpandedIds((current) => {
                                const next = new Set(current);
                                next.delete(entry.id);
                                return next;
                              });
                              return;
                            }
                            if (["Pending", "Partial Pending", "Saved"].includes(entry.status)) {
                              setExpandedIds((current) => {
                                const next = new Set(current);
                                next.add(entry.id);
                                return next;
                              });
                              return;
                            }
                            if (entry.status === "Validation Pending") return onOpenModal("validate", entry);
                            if (entry.status === "Result Done") return onOpenModal("approve", entry);
                            if (entry.status === "Approved") return onOpenModal("publish", entry);
                            if (entry.status === "Published") return onOpenModal("report-view", entry);
                            // Bug fix: Error Reported/Result Rejected used to
                            // fall through to the generic "update-status"
                            // (Technician Notes) modal here — mismatched from
                            // the "Edit" label and from the worklist's own
                            // "Resubmit" action for these two statuses.
                            if (entry.status === "Error Reported" || entry.status === "Result Rejected") return onOpenModal("resubmit", entry);
                            return onOpenModal("update-status", entry);
                          }}>
                                {label}
                              </Button>
                            );
                          })()}
                          {/* Added after the action button per request: the
                              COMPLETE worklist row action set for this status,
                              gated by the SAME status/permission/lock rules as
                              the worklist's actionButtons() — e.g. Reject only
                              on Validation Pending, Error Reported only on
                              Approved/Published, Trend only on Result Done/
                              Approved/Published, Re-run on every status except
                              Pending/Partial Pending. Quick View/Re-run/Trend
                              are ALSO already present in the icon group above
                              (Lock/Delta/Critical/OOR/Re-Run/Schedule/Multi-
                              Step/Audit/Sample Overview/Inventory/Trend, which
                              is untouched) — duplicated here deliberately so
                              the full action set for the current status reads
                              as one complete group right after the button,
                              matching the worklist row exactly, without
                              removing anything from that existing group. Also
                              duplicated after Save/Submit/Validate/Approve/
                              Publish in the EXPANDED result-entry footer below
                              (renderStatusActionIcons), same status rules. */}
                          {renderStatusActionIcons(entry)}
                        </div>
                      </div>
                      {expanded && (
                        <div className="space-y-4 bg-slate-50 px-4 py-4">
                          {!mergedIds.has(entry.id) && (
                            <ResultEntryFetcher
                              entryId={entry.id}
                              onMerged={(detail) => handleDetailMerged(entry.id, detail)}
                            />
                          )}
                          {resultBlock(entry)}
                          <ReportAttachments reportId={entry.id} />
                          {/* Outer "Notes" collapsible wraps the 5 sub-sections below — same
                              <details>/ChevronRight/group-open pattern used for the result
                              groups above, so this reads as one collapsible group instead of
                              5 separate top-level cards. */}
                          <details className="group overflow-hidden rounded-xl border border-slate-200 bg-white">
                            <summary className="flex cursor-pointer list-none items-center gap-2 px-4 py-3 text-sm font-semibold text-slate-700 [&::-webkit-details-marker]:hidden">
                              <ChevronRight className="h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform group-open:rotate-90" />
                              Notes
                            </summary>
                            <div className="space-y-3 border-t border-slate-100 p-3">
                              {([
                                { label: "Useful For", key: "usefulFor", toggle: technicianSettings?.isUsefulForEditable, bodyKey: "usefulFor" },
                                { label: "Interpretation", key: "interpretation", toggle: technicianSettings?.isInterpretationEditable, bodyKey: "interpretation" },
                                { label: "Limitations", key: "limitations", toggle: technicianSettings?.isLimitationsEditable, bodyKey: "limitations" },
                                { label: "Remarks", key: "remarks", toggle: technicianSettings?.isRemarksEditable, bodyKey: "remarks" },
                                { label: "References", key: "references", toggle: technicianSettings?.isReferencesEditable, bodyKey: "references" },
                              ] as const).map(({ label: section, key, toggle, bodyKey }) => {
                                const value = String(entry[key] ?? "");
                                // Each of the 5 Notes sections is independently editable per its own
                                // Technician Settings toggle (all default off). Editing (when allowed)
                                // saves a PER-REPORT override — it never changes the shared LabTest
                                // master's configured default (LABORATORY.docx §4.5), so it affects
                                // only this one patient's report, not every other order of this test.
                                const editable = Boolean(toggle);
                                return (
                                  <details key={section} className="overflow-hidden rounded-xl border border-slate-200 bg-white">
                                    <summary className="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-700">{section}</summary>
                                    <div className="border-t border-slate-100 px-4 py-3">
                                      {editable ? (
                                        <NotesRichTextEditor
                                          value={value}
                                          minHeight={96}
                                          maxHeight={320}
                                          placeholder={`Enter ${section.toLowerCase()}…`}
                                          onChange={(html) => {
                                            const next = { ...entry, [key]: html } as TestWiseEntry;
                                            setLocalEntries((current) => current.map((item) => item.id === entry.id ? next : item));
                                            onUpdateEntry(next);
                                          }}
                                          // Persists on blur (not per-keystroke) as a PER-REPORT override
                                          // (see LabReportService.updateContentSections) — a real,
                                          // meaningful write scoped to this report only. Blur is passed
                                          // through to TinyMCE's own blur event, same trigger the
                                          // plain Textarea version used before this field became rich text.
                                          // NotesRichTextEditor already only calls this when its content
                                          // actually changed since it was last loaded (see its
                                          // `syncedValueRef`) — do not re-guard on `value` here, it's a
                                          // stale closure by blur time (onChange already synced it to match
                                          // the editor, so it would always look "unchanged" and silently
                                          // drop every real edit).
                                          onBlur={(html) => {
                                            updateContentSectionsMutation.mutate({ id: entry.id, body: { [bodyKey]: html } });
                                          }}
                                        />
                                      ) : value ? (
                                        // Master Data authors these as rich text (editor HTML) — render
                                        // it, not the raw markup, so bold/lists/tables/etc. actually show.
                                        <div
                                          className="notes-rte-content text-sm text-slate-600"
                                          dangerouslySetInnerHTML={{ __html: sanitizeRichTextHTML(value) }}
                                        />
                                      ) : (
                                        <p className="text-sm text-slate-600">—</p>
                                      )}
                                    </div>
                                  </details>
                                );
                              })}
                            </div>
                          </details>
                          {["Pending", "Partial Pending", "Saved"].includes(entry.status) ? (() => {
                            // Bug fix: Save/Submit both used to accept a
                            // fully-empty result. Re-checked LABORATORY.docx
                            // directly (§2.2's transition matrix names both
                            // triggers "Technician enters results ->
                            // Save/Submit") — an empty grid was never meant
                            // to reach either Saved or Validation Pending.
                            // Same "at least one real value" threshold for
                            // both (not "every parameter filled in"), so
                            // genuine partial progress across multiple Save
                            // clicks on a multi-parameter test stays allowed.
                            const hasRealValue =
                              entry.quantResults.some((r) => r.observedValue.trim() !== "") ||
                              entry.semiResults.some((r) => r.observedValue.trim() !== "") ||
                              entry.qualResults.some((r) => r.observedValue.trim() !== "");
                            const emptyTitle = "Enter at least one result value before saving or submitting";
                            return (
                              <div className="flex justify-end items-center gap-2 border-t border-dashed border-slate-200 pt-3">
                                <Button
                                  variant="outline"
                                  size="sm"
                                  loading={upsertResultsMutation.isPending || saveMutation.isPending}
                                  disabled={entry.isLocked || upsertResultsMutation.isPending || saveMutation.isPending || !hasRealValue}
                                  title={entry.isLocked ? "Report is locked" : !hasRealValue ? emptyTitle : undefined}
                                  onClick={() => handleSaveResults(entry)}
                                >
                                  Save
                                </Button>
                                <Button
                                  size="sm"
                                  loading={upsertResultsMutation.isPending || submitMutation.isPending}
                                  disabled={entry.isLocked || upsertResultsMutation.isPending || submitMutation.isPending || !hasRealValue}
                                  title={entry.isLocked ? "Report is locked" : !hasRealValue ? emptyTitle : undefined}
                                  onClick={() => handleSubmitResults(entry)}
                                >
                                  Submit
                                </Button>
                                {/* Same complete, status-gated action set as
                                    the collapsed row header (renderStatusActionIcons) —
                                    duplicated here after Save/Submit per request. */}
                                {renderStatusActionIcons(entry)}
                              </div>
                            );
                          })() : (
                            <div className="flex justify-end items-center gap-2 border-t border-dashed border-slate-200 pt-3">
                              {(() => {
                                const isResubmitEntry = entry.status === "Error Reported" || entry.status === "Result Rejected";
                                const canResubmitEntry = hasPermission(LP.ACCESS_RESULT_REJECTED) || hasPermission(LP.ACCESS_ERROR_REPORTED);
                                const disabled = entry.isLocked || (isResubmitEntry && !canResubmitEntry);
                                const title = entry.isLocked ? "Report is locked" : isResubmitEntry && !canResubmitEntry ? "You do not have permission for this action" : undefined;
                                // Bug fix: this fallback always showed
                                // "Validate" with no matching onClick case for
                                // Error Reported/Result Rejected — matched to
                                // the worklist's own "Resubmit" action for
                                // these two statuses (see actionButtonLabel).
                                if (isResubmitEntry) return (
                                  <Button size="sm" variant="outline" className="text-orange-700" disabled={disabled} title={title} onClick={() => onOpenModal("resubmit", entry)}>Resubmit</Button>
                                );
                                // Bug fix: a Published test now correctly stays
                                // open in this modal (it no longer disappears
                                // after Publish — see the "same test stays
                                // open" fix), but this footer's ternary had no
                                // Published branch and silently fell through to
                                // "Validate" with a no-op onClick (none of the
                                // three `if`s below match Published) — a dead
                                // button that looked actionable but did
                                // nothing. Published is a terminal status
                                // (§lifecycle: PENDING→...→APPROVED→PUBLISHED,
                                // no further forward transition), so show
                                // "View" here instead, matching the worklist's
                                // own Published-row action (actionButtonLabel
                                // already returns "View" for the collapsed
                                // button — this mirrors it for the expanded
                                // footer).
                                if (entry.status === "Published") return (
                                  <Button size="sm" variant="outline" onClick={() => onOpenModal("report-view", entry)}>View</Button>
                                );
                                return (
                                  <Button size="sm" disabled={disabled} title={title} onClick={() => {
                                    if (entry.status === "Validation Pending") return onOpenModal("validate", entry);
                                    if (entry.status === "Result Done") return onOpenModal("approve", entry);
                                    if (entry.status === "Approved") return onOpenModal("publish", entry);
                                  }}>{entry.status === "Approved" ? "Publish" : entry.status === "Result Done" ? "Approve" : "Validate"}</Button>
                                );
                              })()}
                              {/* Same complete, status-gated action set as the
                                  collapsed row header (renderStatusActionIcons)
                                  — duplicated here after Validate/Approve/
                                  Publish/Resubmit per request. */}
                              {renderStatusActionIcons(entry)}
                            </div>
                          )}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      </DialogContent>
      {(() => {
        if (!overallResultTarget) return null;
        const targetEntry = localEntries.find((e) => e.id === overallResultTarget.entryId);
        if (!targetEntry) return null;
        const allRows = [...targetEntry.quantResults, ...targetEntry.semiResults, ...targetEntry.qualResults];
        const targetResult = allRows.find((r) => r.id === overallResultTarget.resultParamId);
        if (!targetResult) return null;
        const applied = targetEntry.overallResults[overallResultTarget.resultParamId];
        return (
          <OverallResultModal
            open
            onClose={() => setOverallResultTarget(null)}
            resultParamName={targetResult.resultName}
            groupNames={targetResult.overallResultGroups ?? []}
            content={applied?.content ?? ""}
            templateId={applied?.templateId}
            editable={Boolean(technicianSettings?.isOverallResultEditable)}
            onApply={(templateId) => {
              updateOverallResultMutation.mutate(
                { id: targetEntry.id, resultParamId: overallResultTarget.resultParamId, body: { templateId } },
                {
                  onSuccess: (result) => {
                    const next = {
                      ...targetEntry,
                      overallResults: { ...targetEntry.overallResults, [overallResultTarget.resultParamId]: { content: result.content ?? "", templateId: result.templateId ?? undefined } },
                    };
                    setLocalEntries((current) => current.map((item) => item.id === targetEntry.id ? next : item));
                    onUpdateEntry(next);
                  },
                  onError: (e) => toast.error(getApiErrorMessage(e, "Failed to apply template")),
                },
              );
            }}
            onChange={(html) => {
              // Local-state-only, per keystroke — no network call, so typing
              // doesn't fire a request per character; persisting happens
              // only when the person clicks the modal's explicit Save button
              // (2026-09-24 — was on blur, which fired a silent save on any
              // focus loss, e.g. clicking Close).
              const next = {
                ...targetEntry,
                overallResults: { ...targetEntry.overallResults, [overallResultTarget.resultParamId]: { content: html, templateId: applied?.templateId } },
              };
              setLocalEntries((current) => current.map((item) => item.id === targetEntry.id ? next : item));
              onUpdateEntry(next);
            }}
            onSave={(html) => {
              updateOverallResultMutation.mutate(
                { id: targetEntry.id, resultParamId: overallResultTarget.resultParamId, body: { content: html } },
                {
                  onSuccess: () => toast.success("Overall result saved"),
                  onError: (e) => toast.error(getApiErrorMessage(e, "Failed to save overall result — content may be too long")),
                },
              );
            }}
          />
        );
      })()}
    </Dialog>
  );
}

function GenericActionModal({
  open,
  title,
  actionLabel,
  warning,
  notesRequired,
  pending,
  onOpenChange,
  onConfirm,
}: {
  open: boolean;
  title: string;
  actionLabel: string;
  warning?: string;
  /** Backend enforces notes as mandatory for this action (Reject, Error
   * Reported, Update Status) — disables Confirm until non-empty. */
  notesRequired?: boolean;
  pending?: boolean;
  onOpenChange: (next: boolean) => void;
  /** Receives whatever was typed in Notes — real actions read this and send
   * it to the backend; attachments are not wired (no `/attachments`
   * endpoint exists yet, see Kalnostic-new/TECHNICIAN-REPORTING-GAPS.md #1). */
  onConfirm?: (notes: string) => void;
}) {
  const [notes, setNotes] = useState("");
  // TODO(attach): persist once this action has a backend attachments endpoint
  const [attach, setAttach] = useState<AttachmentItem[]>([]);
  useEffect(() => { if (open) { setNotes(""); setAttach([]); } }, [open]);
  const canConfirm = !notesRequired || notes.trim().length > 0;

  // Ignore Escape/overlay-click while the mutation is in flight — otherwise
  // a user can dismiss the modal mid-request and immediately re-open it to
  // fire a second, overlapping call (Part B #18 in TECHNICIAN-REPORTING-GAPS.md).
  const handleOpenChange = (next: boolean) => { if (!pending) onOpenChange(next); };

  return (
    <Dialog open={open} onOpenChange={handleOpenChange}>
      <DialogContent className="dlg-grad max-w-md">
        <DialogTitle className="sr-only">{title}</DialogTitle>
        <div className="dlg-head">
          <div className="dlg-title">{title}</div>
        </div>
        <div className="dlg-body space-y-4">
          {warning && <div className="rounded-lg border border-red-200 bg-red-50 p-3 text-sm font-medium text-red-700">{warning}</div>}
          <div>
            <Label className="text-xs text-slate-500">Notes{notesRequired ? " (required)" : ""}</Label>
            <Textarea
              rows={4}
              className="mt-1 text-sm"
              placeholder="Add notes..."
              value={notes}
              onChange={(e) => setNotes(e.target.value)}
            />
          </div>
          <div>
            <Label className="text-xs text-slate-500">Attachments</Label>
            {/* TODO(attach): persist once this action has a backend attachments endpoint */}
            <MultiAttachmentUpload value={attach} onChange={setAttach} accept={DOC_ACCEPT} />
          </div>
        </div>
        <div className="dlg-footer">
          <Button variant="outline" onClick={() => onOpenChange(false)} disabled={pending}>Cancel</Button>
          <Button onClick={() => onConfirm?.(notes)} disabled={!canConfirm || pending}>
            {pending ? "Working..." : actionLabel}
          </Button>
        </div>
      </DialogContent>
    </Dialog>
  );
}

/** LABORATORY.docx "Signatory Authority Selection - Approval Pop-up Logic":
 * Signatory 1 is mandatory (only when the report's department actually has
 * ≥1 candidate — an unconfigured department must not block approval) and
 * defaults to the Priority-1 candidate; Signatories 2/3 are optional and
 * default to Priority 2/3 when configured. Candidates come from
 * `GET /lab-reports/:id/signatory-candidates` (department → Person Mapping →
 * isSignatory rows, sorted by priority) — fetched only while the modal is
 * open. Any candidate can be picked into any of the 3 dropdowns; the backend
 * re-validates the selection at Approve time regardless of what this fetch
 * returned. Overriding a signatory here affects only this report, never the
 * master Priority 1/2/3 configuration (business rule from the same doc
 * section). */
function ApproveReportModal({
  open,
  reportId,
  fieldCount,
  pending,
  onOpenChange,
  onConfirm,
}: {
  open: boolean;
  reportId: string | null;
  /** "Number of Signatory Authorities at Report Approval" (Technician
   * Settings → Laboratory Permissions, LABORATORY.docx "Number of Signatory
   * Fields in Approval Pop-up") — 1, 2, or 3. Controls how many of the 3
   * dropdowns render at all; fields beyond this count are not shown and
   * never sent on Approve, even if a prior selection would otherwise still
   * be held in local state. */
  fieldCount: 1 | 2 | 3;
  pending?: boolean;
  onOpenChange: (next: boolean) => void;
  onConfirm?: (details: ApproveReportBody) => void;
}) {
  const { data, isLoading } = useSignatoryCandidates(open ? reportId : null);
  const candidates = data?.candidates ?? [];
  const byPersonId = (id: string | null) => candidates.find(c => c.personId === id) ?? null;
  const byPriorityRank = (slot: 1 | 2 | 3) => candidates.find(c => c.slot === slot) ?? null;

  // How many dropdowns actually render: never more than the department has
  // real candidates for, and never more than the admin-configured setting
  // allows — whichever is smaller. A department with 2 configured
  // signatories shows 2 fields even if the setting says 3; a department with
  // 0 shows none at all (no empty/disabled placeholder), regardless of the
  // setting.
  const visibleFieldCount = Math.min(fieldCount, candidates.length) as 0 | 1 | 2 | 3;

  const [notes, setNotes] = useState("");
  // TODO(attach): persist once report-approval has a backend attachments endpoint
  const [attach, setAttach] = useState<AttachmentItem[]>([]);
  const [signatory1, setSignatory1] = useState<string | null>(null);
  const [signatory2, setSignatory2] = useState<string | null>(null);
  const [signatory3, setSignatory3] = useState<string | null>(null);

  useEffect(() => {
    if (!open) return;
    setNotes("");
    setAttach([]);
  }, [open]);

  // Default-populate from Priority 1/2/3 once candidates have loaded for this
  // report — separate from the reset effect above so a prior report's
  // selection never bleeds into a newly-opened one, but also doesn't briefly
  // flash a stale default before the fetch resolves. Slots beyond
  // visibleFieldCount are left null — they're not rendered and must not
  // silently carry a default into the Approve payload either.
  useEffect(() => {
    if (!open || isLoading) return;
    setSignatory1(visibleFieldCount >= 1 ? byPriorityRank(1)?.personId ?? null : null);
    setSignatory2(visibleFieldCount >= 2 ? byPriorityRank(2)?.personId ?? null : null);
    setSignatory3(visibleFieldCount >= 3 ? byPriorityRank(3)?.personId ?? null : null);
  }, [open, isLoading, data, visibleFieldCount]);

  const handleOpenChange = (next: boolean) => { if (!pending) onOpenChange(next); };
  // Signatory 1 is only mandatory when it's actually shown — a department
  // with zero candidates renders no fields at all and must not block
  // approval (mirrors the backend's own resolveSignatoryColumns rule).
  const canConfirm = visibleFieldCount === 0 || Boolean(signatory1);

  const signatoryLabel = (c: ApiSignatoryCandidate) =>
    c.resolvable ? `${c.displayName}${c.designation ? ` (${c.designation})` : ""}` : `${c.displayName} — no longer available`;

  const renderOptions = () => candidates.map(c => (
    <SelectItem key={c.personId} value={c.personId} disabled={!c.resolvable}>
      {signatoryLabel(c)}
    </SelectItem>
  ));

  return (
    <Dialog open={open} onOpenChange={handleOpenChange}>
      <DialogContent className="dlg-grad max-w-md">
        <DialogTitle className="sr-only">Approve Report</DialogTitle>
        <div className="dlg-head">
          <div className="dlg-title">Approve Report</div>
        </div>
        <div className="dlg-body space-y-4">
          <div>
            <Label className="text-xs text-slate-500">Notes</Label>
            <Textarea
              rows={4}
              className="mt-1 text-sm"
              placeholder="Add notes..."
              value={notes}
              onChange={(e) => setNotes(e.target.value)}
            />
          </div>
          <div>
            <Label className="text-xs text-slate-500">Attachments</Label>
            {/* TODO(attach): persist once report-approval has a backend attachments endpoint */}
            <MultiAttachmentUpload value={attach} onChange={setAttach} accept={DOC_ACCEPT} />
          </div>

          {isLoading && (
            <div className="text-xs text-slate-500 italic">Loading signatories...</div>
          )}

          {!isLoading && candidates.length === 0 && (
            <div className="text-xs text-slate-500 italic">
              No signatories configured for this department.
            </div>
          )}

          {!isLoading && visibleFieldCount >= 1 && (
            <div>
              <Label className="text-xs text-slate-500">
                Signatory Authority 1 <span className="text-red-500">*</span>
              </Label>
              <Select value={signatory1 ?? undefined} onValueChange={setSignatory1}>
                <SelectTrigger className="mt-1 h-9 text-sm"><SelectValue placeholder="Select Signatory Authority 1" /></SelectTrigger>
                <SelectContent>{renderOptions()}</SelectContent>
              </Select>
            </div>
          )}

          {!isLoading && visibleFieldCount >= 2 && (
            <div>
              <Label className="text-xs text-slate-500">Signatory Authority 2 (Optional)</Label>
              <Select value={signatory2 ?? undefined} onValueChange={setSignatory2}>
                <SelectTrigger className="mt-1 h-9 text-sm"><SelectValue placeholder="Select Signatory Authority 2" /></SelectTrigger>
                <SelectContent>{renderOptions()}</SelectContent>
              </Select>
            </div>
          )}

          {!isLoading && visibleFieldCount >= 3 && (
            <div>
              <Label className="text-xs text-slate-500">Signatory Authority 3 (Optional)</Label>
              <Select value={signatory3 ?? undefined} onValueChange={setSignatory3}>
                <SelectTrigger className="mt-1 h-9 text-sm"><SelectValue placeholder="Select Signatory Authority 3" /></SelectTrigger>
                <SelectContent>{renderOptions()}</SelectContent>
              </Select>
            </div>
          )}
        </div>
        <div className="dlg-footer">
          <Button variant="outline" onClick={() => onOpenChange(false)} disabled={pending}>Cancel</Button>
          <Button
            onClick={() => onConfirm?.({
              notes: notes.trim() || undefined,
              signatoryAuthority1Id: visibleFieldCount >= 1 ? byPersonId(signatory1)?.personId : undefined,
              signatoryAuthority2Id: visibleFieldCount >= 2 ? byPersonId(signatory2)?.personId : undefined,
              signatoryAuthority3Id: visibleFieldCount >= 3 ? byPersonId(signatory3)?.personId : undefined,
            })}
            disabled={!canConfirm || pending || isLoading}
          >
            {pending ? "Working..." : "Approve"}
          </Button>
        </div>
      </DialogContent>
    </Dialog>
  );
}

/* Order/Sample/Tech Notes here now use the same real GET/POST
   /lab-reports/:id/notes as Test Entry's NotesModalContent — `findNotes`
   was fixed to expand across every LabReport sharing the same orderId
   (LABORATORY.docx §4.1/§4.2: these 3 tabs are order-wide, "visible to
   every technician who opens the order"), so any one of this order's
   report ids works as the anchor; a note added from either surface is now
   visible from both. Documents remains mock/local-only (no `/attachments`
   endpoint exists yet — separate, larger gap, unrelated to this fix). */
// Per-order document list, held in memory keyed by order id.
// TODO(attach): persist once order documents have a backend
const _ovDocs = new Map<string, AttachmentItem[]>();

function OrderOverviewDialog({
  open,
  context,
  rows,
  onClose,
  onOpenModal,
  onOpenEntry,
  onBulkStatusChange,
}: {
  open: boolean;
  context: Partial<TestWiseEntry>;
  rows: TestWiseEntry[];
  onClose: () => void;
  onOpenModal: (type: string, ctx: unknown) => void;
  onOpenEntry: (entry: TestWiseEntry, scope: "patient" | "test") => void;
  onBulkStatusChange: (rowsToUpdate: TestWiseEntry[], actionKey: BulkActionKey) => void;
}) {
  const oid = context.orderId ?? "";
  const [dispatchStatus, setDispatchStatus] = useState<Record<string, string>>({});
  const [selectedTests, setSelectedTests] = useState<Set<string>>(new Set());

  const [docs, setDocs] = useState<AttachmentItem[]>(() => _ovDocs.get(oid) ?? []);

  const [notesDialog, setNotesDialog] = useState<"order" | "sample" | "tech" | null>(null);
  const [docsOpen,    setDocsOpen]    = useState(false);
  const [newNote,     setNewNote]     = useState("");

  // Fix: Load docs when the Order ID changes to prevent data bleeding between patient orders
  useEffect(() => {
    if (!oid) return;
    setDocs(_ovDocs.get(oid) ?? []);
    // Bug fix: this dialog is a single persistent instance (shown/hidden via
    // `open`, never unmounted), so React never resets its own state between
    // different orders on its own. selectedTests/dispatchStatus were missing
    // from this reset — leaving a previous order's checked rows (and its
    // whole bulk-action toolbar) visibly active on a newly opened, unrelated
    // order.
    setSelectedTests(new Set());
    setDispatchStatus({});
  }, [oid]);

  useEffect(() => { _ovDocs.set(oid, docs); }, [oid, docs]);

  const orderTests = rows.filter(r => r.orderId === context.orderId);
  // Anchor report id for the real Notes endpoint — findNotes expands to
  // every LabReport sharing this order, so any one of this order's tests
  // works; picking the first is arbitrary but consistent per render.
  const notesAnchorId = orderTests[0]?.id ?? null;
  const notesCategory: PlainNoteCategory | undefined =
    notesDialog === "order" ? "ORDER" : notesDialog === "sample" ? "SAMPLE" : notesDialog === "tech" ? "TECH" : undefined;
  const { data: orderNotesData } = useLabReportNotes(notesAnchorId, "ORDER");
  const { data: sampleNotesData } = useLabReportNotes(notesAnchorId, "SAMPLE");
  const { data: techNotesData } = useLabReportNotes(notesAnchorId, "TECH");
  const orderNotes = orderNotesData ?? [];
  const sampleNotes = sampleNotesData ?? [];
  const techNotes = techNotesData ?? [];
  const createNoteMutation = useCreateNote();
  const openNested = (type: string, ctx: unknown) => { onClose(); onOpenModal(type, ctx); };
  const openEntry  = (entry: TestWiseEntry) => { onClose(); onOpenEntry(entry, "test"); };
  const selectedList = orderTests.filter(t => selectedTests.has(t.id));
  const hasStatus = (s: TestStatus) => selectedList.some(t => t.status === s);

  const currentNotes = notesDialog === "order" ? orderNotes : notesDialog === "sample" ? sampleNotes : techNotes;
  const notesTitle   = notesDialog === "order" ? "Order Notes" : notesDialog === "sample" ? "Sample Notes" : "Tech Notes";

  const addNote = () => {
    const text = newNote.trim();
    if (!text || !notesAnchorId || !notesCategory) return;
    createNoteMutation.mutate(
      { id: notesAnchorId, body: { category: notesCategory, body: text } },
      {
        onSuccess: () => { setNewNote(""); toast.success("Note added"); },
        onError: () => toast.error("Failed to add note"),
      },
    );
  };
  // No delete-a-note endpoint exists on the real backend (matches
  // NotesModalContent — Test Entry's own Notes tabs have never had a
  // delete action either), so the remove button is gone from this dialog
  // too, not silently kept pointing at nothing.
  const rowActionBtn = (t: TestWiseEntry) => {
    // All transitions reachable from here are lock-gated on the real
    // backend (LabReportService.requireReport) — see actionButtons' own
    // gating comment for the full list.
    const lockedProps = { disabled: t.isLocked, title: t.isLocked ? "Report is locked" : undefined };
    if (t.status === "Pending" || t.status === "Partial Pending" || t.status === "Saved")
      return <Button size="sm" variant="outline" {...lockedProps} onClick={() => openEntry(t)}>Enter</Button>;
    if (t.status === "Validation Pending")
      return <Button size="sm" variant="outline" className="text-green-700" {...lockedProps} onClick={() => openNested("validate", t)}>Validate</Button>;
    if (t.status === "Result Done")
      return <Button size="sm" variant="outline" className="text-green-700" {...lockedProps} onClick={() => openNested("approve", t)}>Approve</Button>;
    if (t.status === "Approved")
      return <Button size="sm" {...lockedProps} onClick={() => openNested("publish", t)}>Publish</Button>;
    if (t.status === "Error Reported" || t.status === "Result Rejected")
      return <Button size="sm" variant="outline" className="text-orange-700" {...lockedProps} onClick={() => openNested("resubmit", t)}>Resubmit</Button>;
    return null;
  };

  const grid: Array<[string, React.ReactNode]> = [
    ["Order No",       context.orderId ?? "–"],
    ["Patient Name",   context.patientName ?? "–"],
    ["UHID",           context.umiId ?? "–"],
    ["Age / Gender",   context.patientAge !== undefined && context.patientGender ? `${context.patientAge}Y / ${context.patientGender}` : "–"],
    ["Mobile",         context.mobile ?? "–"],
    ["Branch",         context.branch ?? "–"],
    ["Ref Panel",      context.refPanel ?? "–"],
    ["Ref By",         context.refBy ?? "–"],
    ["Order Mode",     context.isOutsourced ? "Outsource" : "Walk-in"],
    ["Payment Status", context.paymentStatus
      ? <StatusBadge key="ps" value={PAYMENT_STATUS_LABEL[context.paymentStatus] ?? context.paymentStatus} />
      : "–"],
    ["Billing Type",   context.billingType ?? "–"],
    ["Order Date",     context.orderDate ?? "–"],
  ];

  return (
    <>
    <Dialog open={open} onOpenChange={(next) => !next && onClose()}>
      <DialogContent className="dlg-grad max-w-4xl">
        <DialogTitle className="sr-only">Diagnostics Order Details</DialogTitle>
        <div className="dlg-head">
          <div className="dlg-title">Diagnostics Order Details</div>
          <div className="dlg-sub">{context.orderId}</div>
        </div>
        <div className="dlg-body space-y-4">
          {/* Patient info card */}
          <div className="bg-white rounded-xl border border-gray-200 shadow-sm px-6 py-5">
            <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-4">
              {grid.map(([label, value]) => (
                <div key={label as string} className="min-w-0">
                  <div className="text-[10px] font-semibold tracking-wider text-gray-400 uppercase mb-1">{label as string}</div>
                  <div className="text-sm font-medium text-gray-800 truncate">{value}</div>
                </div>
              ))}
            </div>
          </div>

          {/* Notes & docs strip */}
          <div className="bg-white rounded-xl border border-gray-200 shadow-sm px-5 py-3 flex items-center justify-between flex-wrap gap-3">
            <div className="flex items-center gap-2 flex-wrap">
              <button type="button" onClick={() => { setNewNote(""); setNotesDialog("order"); }}
                className="relative flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-600 hover:bg-orange-50 hover:text-orange-700 transition-colors">
                <FileText className="w-4 h-4 text-orange-500" /><span>Order Notes</span>
                {orderNotes.length > 0 && <span className="absolute -top-1 -right-1 min-w-[16px] h-4 px-1 bg-orange-500 text-white rounded-full text-[9px] flex items-center justify-center font-bold">{orderNotes.length}</span>}
              </button>
              <button type="button" onClick={() => { setNewNote(""); setNotesDialog("sample"); }}
                className="relative flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                <FlaskConical className="w-4 h-4 text-blue-500" /><span>Sample Notes</span>
                {sampleNotes.length > 0 && <span className="absolute -top-1 -right-1 min-w-[16px] h-4 px-1 bg-blue-500 text-white rounded-full text-[9px] flex items-center justify-center font-bold">{sampleNotes.length}</span>}
              </button>
              <button type="button" onClick={() => { setNewNote(""); setNotesDialog("tech"); }}
                className="relative flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-600 hover:bg-purple-50 hover:text-purple-700 transition-colors">
                <Microscope className="w-4 h-4 text-purple-500" /><span>Tech Notes</span>
                {techNotes.length > 0 && <span className="absolute -top-1 -right-1 min-w-[16px] h-4 px-1 bg-purple-500 text-white rounded-full text-[9px] flex items-center justify-center font-bold">{techNotes.length}</span>}
              </button>
              <button type="button" disabled title="Documents — not yet available"
                className="relative flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-400 opacity-60 cursor-not-allowed">
                <FileText className="w-4 h-4 text-gray-400" /><span>Documents</span>
              </button>
            </div>
          </div>

          {/* ── Bulk action bar — driven by the shared STATUS_BULK_ACTIONS
               table (same source the main worklist's bulk bar uses), instead
               of a separately hand-written Validate/Approve/Publish block, so
               a future change to that table can't drift out of sync here
               again (TECHNICIAN-REPORTING-GAPS.md Part B #17). Only
               non-notes-required actions are offered here — Reject/Error
               Reported need a Notes prompt this dialog doesn't have; adding
               them without one would let a bulk call reach the backend
               missing its required `notes` field and fail, so they're
               deliberately left off this bar (still available per-row via
               rowActionBtn -> the real Reject/Error Reported modals). ── */}
          {selectedTests.size > 0 && (
            <div className="flex flex-wrap items-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-4 py-2.5">
              <span className="text-xs font-semibold text-blue-700">{selectedTests.size} of {orderTests.length} selected</span>
              <div className="mx-1 h-4 w-px bg-blue-200" />
              {(Object.keys(STATUS_BULK_ACTIONS) as TestStatus[])
                .filter(hasStatus)
                .flatMap((status) => STATUS_BULK_ACTIONS[status] ?? [])
                .filter((actionKey, index, all) => all.indexOf(actionKey) === index)
                .filter((actionKey) => !BULK_ACTION_META[actionKey].requiresNotes)
                .map((actionKey) => {
                  const meta = BULK_ACTION_META[actionKey];
                  const targets = selectedList.filter((t) => (STATUS_BULK_ACTIONS[t.status] ?? []).includes(actionKey));
                  if (!targets.length) return null;
                  return (
                    <Button
                      key={actionKey}
                      size="sm"
                      className={cn("h-7 text-xs", meta.hoverClass)}
                      onClick={() => {
                        onBulkStatusChange(targets, actionKey);
                        setSelectedTests(new Set());
                      }}
                    >
                      {meta.label}
                    </Button>
                  );
                })}
              {/* Disabled: dispatch status is currently local-only
                  (setDispatchStatus), never persisted to any real backend
                  concept — no Order/OrderItem "dispatch status" field or
                  endpoint exists today. Kept visible (not removed) so it's
                  clear the action exists but isn't wired up yet. */}
              <Button size="sm" variant="outline" className="h-7 text-xs" disabled title="Not yet available">
                <Send className="mr-1 h-3 w-3" />Dispatch
              </Button>
              <Button size="sm" variant="outline" className="h-7 text-xs" onClick={() => {
                const w = window.open("", "_blank", "width=750,height=700");
                if (!w) return;
                const trs = selectedList.map((t, i) =>
                  '<tr style="border-bottom:1px solid #e2e8f0"><td style="padding:8px 12px">' + (i+1) +
                  '</td><td style="padding:8px 12px">' + t.testName +
                  '</td><td style="padding:8px 12px">' + t.sampleStatus +
                  '</td><td style="padding:8px 12px">' + t.status +
                  '</td><td style="padding:8px 12px">' + t.priority + '</td></tr>'
                ).join('');
                w.document.write(
                  '<!DOCTYPE html><html><head><title>Test Reports — ' + oid + '</title>' +
                  '<style>body{font-family:sans-serif;padding:24px;color:#1e293b}h2{color:#1d4ed8;border-bottom:2px solid #dbeafe;padding-bottom:8px;margin-bottom:16px}table{width:100%;border-collapse:collapse}th{background:#eff6ff;color:#1e40af;text-align:left;padding:8px 12px;font-size:12px;font-weight:700}td{font-size:12px;color:#374151}</style>' +
                  '</head><body><h2>Test Reports — ' + oid + '</h2>' +
                  '<table><thead><tr><th>S.No</th><th>Test Name</th><th>Sample Status</th><th>Report Status</th><th>Priority</th></tr></thead>' +
                  '<tbody>' + trs + '</tbody></table>' +
                  '<p style="color:#94a3b8;font-size:11px;margin-top:16px">Printed: ' + formatDateTime(new Date()) + '</p>' +
                  '<' + 'script>window.onload=function(){window.print()};<' + '/script>' +
                  '</body></html>'
                );
                w.document.close();
              }}>
                <Printer className="mr-1 h-3 w-3" />Print
              </Button>
              <Button size="sm" variant="outline" className="h-7 text-xs" onClick={() => {
                const headers = ["S.No","Order ID","Test Name","Sample Status","Report Status","Priority","Branch"];
                const csvRows = selectedList.map((t, i) =>
                  [i+1, t.orderId, t.testName, t.sampleStatus, t.status, t.priority, t.branch].map(v => `"${v}"`).join(",")
                );
                const csv = [headers.join(","), ...csvRows].join("\n");
                const a = document.createElement("a");
                a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
                a.download = `reports-${oid}-${new Date().toISOString().slice(0,10)}.csv`;
                a.click();
              }}>
                <Download className="mr-1 h-3 w-3" />Download
              </Button>
              <Button size="sm" variant="outline" className="h-7 text-xs" onClick={() => {
                // Bug fix: this used to pass { ids: [...] } — an object with
                // no `.id` field — into the shared single-entry "rerun" modal,
                // whose onConfirm reads `ctx.id` and silently sent
                // `id: undefined` to the backend. Fixed by passing the real
                // selected rows plus a `bulkRows` marker the consumer checks
                // for, so it loops over every selected test instead.
                openNested("rerun", { ...selectedList[0], bulkRows: selectedList });
              }}>
                <RotateCcw className="mr-1 h-3 w-3" />Re-Run
              </Button>
              <button type="button" className="ml-auto ib" title="Clear selection" onClick={() => setSelectedTests(new Set())}>
                <X className="h-3.5 w-3.5" />
              </button>
            </div>
          )}

          <div className="overflow-hidden rounded-xl border border-slate-200">
            <table className="w-full text-sm">
              <thead>
                <tr className="bg-blue-50 text-left">
                  <th className="px-3 py-2.5">
                    <input type="checkbox" title="Select all" aria-label="Select all"
                      checked={selectedTests.size === orderTests.length && orderTests.length > 0}
                      onChange={(e) => setSelectedTests(e.target.checked ? new Set(orderTests.map(t => t.id)) : new Set())} />
                  </th>
                  <th className="px-3 py-2.5 text-xs font-semibold text-blue-700">S.No</th>
                  <th className="px-3 py-2.5 text-xs font-semibold text-blue-700">Test Name</th>
                  <th className="px-3 py-2.5 text-xs font-semibold text-blue-700">Sample Status</th>
                  <th className="px-3 py-2.5 text-xs font-semibold text-blue-700">Report Status</th>
                  <th className="px-3 py-2.5 text-xs font-semibold text-blue-700">Dispatch Status</th>
                  <th className="px-3 py-2.5 text-xs font-semibold text-blue-700 whitespace-nowrap">Actions</th>
                </tr>
              </thead>
              <tbody>
                {orderTests.map((t, i) => (
                  <tr key={t.id} className="border-t border-slate-100 hover:bg-slate-50/50">
                    <td className="px-3 py-2.5">
                      <input type="checkbox" title={`Select ${t.testName}`} aria-label={`Select ${t.testName}`}
                        checked={selectedTests.has(t.id)}
                        onChange={(e) => setSelectedTests(curr => {
                          const next = new Set(curr);
                          if (e.target.checked) next.add(t.id); else next.delete(t.id);
                          return next;
                        })} />
                    </td>
                    <td className="px-3 py-2.5 text-slate-600">{i + 1}</td>
                    <td className="px-3 py-2.5">
                      <div className="font-medium text-slate-800">{t.testName}</div>
                      <div className="text-[10px] text-slate-400">{t.testType}</div>
                      {t.multiStepProcessType && (
                        <div className="mt-0.5 flex items-center gap-1 text-[10px] font-medium text-purple-600" title="Multi-Step Test Process">
                          <Activity className="h-3 w-3" />
