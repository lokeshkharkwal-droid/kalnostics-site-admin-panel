function badgeClass(value: string) {
  // Comma-joined multi-sample values (e.g. "HALT, ACCEPTED") color off the
  // first status, since the badge renders as one span, not one pill per value.
  const firstToken = value.split(",")[0]?.trim() ?? value;
  return (
    statusColors[value] ??
    tatColors[value] ??
    sampleColors[value] ??
    accessionStatusColors[firstToken] ??
    "bg-slate-100 text-slate-700"
  );
}

function parseDate(value: string) {
  const normalized = value.includes("/")
    ? (() => {
        const match = value.match(/^(\d{2})\/(\d{2})\/(\d{4})(?:\s+(\d{2}):(\d{2}))?/);
        if (!match) return null;
        const [, dd, mm, yyyy, hh = "00", min = "00"] = match;
        return new Date(Number(yyyy), Number(mm) - 1, Number(dd), Number(hh), Number(min));
      })()
    : new Date(value);
  return normalized instanceof Date && !Number.isNaN(normalized.getTime()) ? normalized : null;
}

function formatQuickRange(range: string) {
  const today = new Date();
  let from = new Date(today);
  let to = new Date(today);

  switch (range) {
    case "Today":
      break;
    case "Yesterday":
      from.setDate(today.getDate() - 1);
      to = new Date(from);
      break;
    case "Last Week":
      from.setDate(today.getDate() - 7);
      break;
    case "Last Month":
    case "Previous Month":
      from = new Date(today.getFullYear(), today.getMonth() - 1, 1);
      to = new Date(today.getFullYear(), today.getMonth(), 0);
      break;
    case "This Month":
      from = new Date(today.getFullYear(), today.getMonth(), 1);
      break;
    case "Last Quarter": {
      const currentQuarter = Math.floor(today.getMonth() / 3);
      const startMonth = currentQuarter === 0 ? 9 : (currentQuarter - 1) * 3;
      const year = currentQuarter === 0 ? today.getFullYear() - 1 : today.getFullYear();
      from = new Date(year, startMonth, 1);
      to = new Date(year, startMonth + 3, 0);
      break;
    }
    case "Last 3 Months":
      from = new Date(today.getFullYear(), today.getMonth() - 2, 1);
      break;
    case "Last 6 Months":
      from = new Date(today.getFullYear(), today.getMonth() - 5, 1);
      break;
    case "Last 1 Year":
      from = new Date(today.getFullYear() - 1, today.getMonth(), today.getDate());
      break;
    default:
      break;
  }

  const toInput = (date: Date) => date.toISOString().slice(0, 10);
  return { from: toInput(from), to: toInput(to) };
}

/** ISO datetime → the local `YYYY-MM-DDTHH:mm` shape `<input type="datetime-
 * local">` expects. Must build from local getters, not `toISOString()` (which
 * shifts to UTC and would display the wrong wall-clock time to the user). */
function toDatetimeLocalValue(iso: string | null | undefined): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function StatusBadge({ value }: { value: string }) {
