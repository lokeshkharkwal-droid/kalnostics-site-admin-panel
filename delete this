                  <SelectValue placeholder={groupNames.length === 0 ? "No compatible templates configured" : isFetching ? "Loading templates…" : templates.length === 0 ? "No matching templates" : "Select a template to apply…"} />
                </SelectTrigger>
                <SelectContent>
                  {templates.map((t) => (
                    <SelectItem key={t.id} value={t.id}>{t.name}</SelectItem>
