/**
 * Real Trend Report — `GET /lab-reports/:id/trend`, replacing the old
 * hardcoded scatter dots + static 3-row table. A report can have many result
 * parameters (e.g. CBC has ~20), so there's no single "the" trend for a
 * report — the technician picks which parameter to trend from a dropdown
 * (this report's own `resultParams`, via the already-used `useLabReport`
 * hook), then the real historical series for that patient + parameter loads.
 */
function TrendReportContent({ entryId, onClose }: { entryId: string; onClose: () => void }) {
  const { data: detail, isLoading: loadingDetail } = useLabReport(entryId);
  const [resultParamId, setResultParamId] = useState<string | null>(null);

  const params = detail?.resultParams ?? [];
  const activeParamId = resultParamId ?? params[0]?.id ?? null;
  const { data: points, isLoading: loadingTrend, isError } = useTrend(entryId, activeParamId);

  if (loadingDetail) {
    return <div className="dlg-body py-10 text-center text-sm text-slate-400">Loading report...</div>;
  }
  if (params.length === 0) {
    return (
      <>
        <div className="dlg-body py-10 text-center text-sm text-slate-400">No result parameters on this report.</div>
        <div className="dlg-footer"><Button variant="outline" onClick={onClose}>Close</Button></div>
      </>
    );
  }

  // Real values only (no fabricated position when observed1 isn't numeric),
  // scaled against this series' own min/max — not the reference range, since
  // a series can sit entirely inside or outside the range and both should
  // still be visible on the chart.
  const plottable = (points ?? [])
    .map((p) => ({ ...p, value: p.observed1 === null ? NaN : Number(p.observed1) }))
    .filter((p) => Number.isFinite(p.value));
  const values = plottable.map((p) => p.value);
  const min = values.length ? Math.min(...values) : 0;
  const max = values.length ? Math.max(...values) : 0;
  const span = max - min || 1;

  return (
    <>
      <div className="dlg-body space-y-4">
        <div className="flex items-center gap-2">
          <span className="text-xs font-medium text-slate-500">Parameter</span>
          <Select
            value={activeParamId ?? undefined}
            onValueChange={(v) => setResultParamId(v)}
          >
            <SelectTrigger className="h-8 w-56 text-xs"><SelectValue /></SelectTrigger>
            <SelectContent>
              {params.map((p) => (
                <SelectItem key={p.id} value={p.id}>{p.parameterName}</SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>

        {loadingTrend ? (
          <div className="py-10 text-center text-sm text-slate-400">Loading trend...</div>
        ) : isError ? (
          <div className="py-10 text-center text-sm text-red-500">Could not load trend data.</div>
        ) : plottable.length === 0 ? (
          <div className="py-10 text-center text-sm text-slate-400">No prior numeric results for this parameter yet.</div>
        ) : (
          <div className="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <div className="flex gap-2">
              {/* Y-axis: min/max of this series' own plotted values (not the
                  reference range — a series can sit entirely inside or
                  outside the range and both should still be readable). */}
              <div className="flex h-56 w-14 shrink-0 flex-col justify-between text-right text-[10px] text-slate-400">
                <span>{max}{plottable[0]?.unit ? ` ${plottable[0].unit}` : ""}</span>
                <span>{min}{plottable[0]?.unit ? ` ${plottable[0].unit}` : ""}</span>
              </div>
              <div className="relative h-56 flex-1 border-b border-l border-slate-300">
                {plottable.map((p, i) => {
                  const leftPct = plottable.length === 1 ? 50 : (i / (plottable.length - 1)) * 80 + 10;
                  const bottomPct = ((p.value - min) / span) * 70 + 15;
                  return (
                    <div
                      key={p.labReportId}
                      title={`${formatOrderDate(p.date ?? "", null)} • ${p.observed1 ?? "—"}${p.unit ? ` ${p.unit}` : ""} • ${p.flag ?? "—"}`}
                      className="absolute flex -translate-x-1/2 translate-y-1/2 flex-col items-center"
                      style={{ left: `${leftPct}%`, bottom: `${bottomPct}%` }}
                    >
                      <span
                        className={cn(
                          "mb-1 whitespace-nowrap text-[10px] font-medium",
                          p.flag === "High" ? "text-red-600" : p.flag === "Low" ? "text-blue-600" : "text-green-700",
                        )}
                      >
                        {p.observed1}{p.unit ? ` ${p.unit}` : ""}
                      </span>
                      <div
                        className={cn(
                          "h-2.5 w-2.5 rounded-full",
                          p.flag === "High" ? "bg-red-500" : p.flag === "Low" ? "bg-blue-500" : "bg-green-500",
                        )}
                      />
                      <span className="mt-1 whitespace-nowrap text-[9px] text-slate-400">
                        {formatOrderDate(p.date ?? "", null)}
                      </span>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        )}

        {plottable.length > 0 && (
          <div className="overflow-hidden rounded-xl border border-slate-200">
            <table className="w-full text-sm">
              <thead className="bg-blue-50 text-blue-900/70 text-left text-xs">
                <tr><th className="px-3 py-2">Date</th><th className="px-3 py-2">Value</th><th className="px-3 py-2">Reference Range</th><th className="px-3 py-2">Flag</th></tr>
              </thead>
              <tbody>
                {(points ?? []).map((p) => (
                  <tr key={p.labReportId} className="border-t border-slate-100">
                    <td className="px-3 py-2">{formatOrderDate(p.date ?? "", null)}</td>
                    <td className="px-3 py-2">{p.observed1 ?? "—"}{p.unit ? ` ${p.unit}` : ""}{p.observed2 ? ` (secondary: ${p.observed2})` : ""}</td>
                    <td className="px-3 py-2">{p.referenceDisplay ?? "—"}</td>
                    <td className={cn("px-3 py-2 font-medium", p.flag ? TREND_FLAG_COLOR[p.flag] : "text-slate-400")}>{p.flag ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
      <div className="dlg-footer"><Button variant="outline" onClick={onClose}>Close</Button></div>
    </>
  );
}

/** Delta Check modal body — fetches this report's real `resultParams` via
 * `GET /lab-reports/:id` (the same real endpoint Trend Report already uses),
 * instead of reading `quantResults`/`semiResults`/`qualResults` off the
 * worklist row passed into the modal. Those arrays only get populated once
 * the row has been expanded in Test/Patient Entry (`ResultEntryFetcher` runs
 * on expand, not before) — raising Delta Check straight from the collapsed
 * row header meant the Parameter picker never appeared, even for a genuine
 * multi-parameter test, because the row's own copy of its results was still
 * empty. Fetching independently here means the picker is now reliable
 * regardless of whether the row was ever expanded first. */
function DeltaCheckContent({
  entryId,
  testName,
  patientName,
  paramId,
  onParamChange,
  notes,
  onNotesChange,
  pending,
  onCancel,
  onSubmit,
}: {
  entryId: string;
  testName?: string;
  patientName?: string;
  paramId: string | null;
  onParamChange: (id: string) => void;
  notes: string;
  onNotesChange: (value: string) => void;
  pending: boolean;
  onCancel: () => void;
  onSubmit: () => void;
}) {
  const { data: detail } = useLabReport(entryId);
  const params = detail?.resultParams ?? [];
  // TODO(attach): persist once delta-check has a backend
  const [attach, setAttach] = useState<AttachmentItem[]>([]);

  // Auto-select the first parameter once real params load, if nothing (or a
  // now-invalid id from a stale row copy) is selected yet — mirrors the
  // existing "only one parameter -> pre-select, no picker needed" behavior.
  useEffect(() => {
    if (params.length > 0 && !params.some((p) => p.id === paramId)) {
      onParamChange(params[0].id);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [params.map((p) => p.id).join(",")]);

  return (
    <>
      <div className="dlg-head">
        <div className="dlg-title">Delta Check</div>
        <div className="dlg-sub">{testName} • {patientName}</div>
      </div>
      <div className="dlg-body space-y-4">
        {params.length > 1 && (
          <div>
            <Label className="text-xs text-slate-500">Parameter</Label>
            <Select value={paramId ?? undefined} onValueChange={onParamChange}>
              <SelectTrigger className="mt-1 h-9 text-xs"><SelectValue placeholder="Select parameter" /></SelectTrigger>
              <SelectContent>
                {params.map((p) => (
                  <SelectItem key={p.id} value={p.id}>{p.parameterName}</SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>
        )}
        <div><Label className="text-xs text-slate-500">Notes</Label><Textarea rows={4} className="mt-1 text-sm" placeholder="Add delta check notes or findings..." value={notes} onChange={(e) => onNotesChange(e.target.value)} /></div>
        <div>
          <Label className="text-xs text-slate-500">Attach File</Label>
          {/* TODO(attach): persist once delta-check has a backend */}
          <MultiAttachmentUpload value={attach} onChange={setAttach} accept={DOC_ACCEPT} />
        </div>
      </div>
      <div className="dlg-footer">
        <Button variant="outline" onClick={onCancel} disabled={pending}>Cancel</Button>
        <Button disabled={!notes.trim() || pending} onClick={onSubmit}>
          <ArrowLeftRight className="h-3.5 w-3.5 mr-1.5" />
          {pending ? "Submitting..." : "Submit"}
        </Button>
      </div>
    </>
  );
}

