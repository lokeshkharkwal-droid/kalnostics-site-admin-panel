/* Static Tailwind class map for percentage-fill bars.
   Listed literally so Tailwind JIT can detect and emit each utility.
   Input is rounded to nearest 5% for a 21-bucket palette. */
const PCT_BAR_CLASSES: Record<number, string> = {
  0: "w-0", 5: "w-[5%]", 10: "w-[10%]", 15: "w-[15%]", 20: "w-[20%]",
  25: "w-[25%]", 30: "w-[30%]", 35: "w-[35%]", 40: "w-[40%]", 45: "w-[45%]",
  50: "w-1/2", 55: "w-[55%]", 60: "w-[60%]", 65: "w-[65%]", 70: "w-[70%]",
  75: "w-3/4", 80: "w-[80%]", 85: "w-[85%]", 90: "w-[90%]", 95: "w-[95%]",
  100: "w-full",
};
function pctBarClass(pct: number): string {
  const bucket = Math.max(0, Math.min(100, Math.round(pct / 5) * 5));
  return PCT_BAR_CLASSES[bucket] ?? "w-0";
}

