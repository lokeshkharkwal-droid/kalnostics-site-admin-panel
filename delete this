/** Card + title/count chrome around `DataTable`, shared by the 5 special
 * worklists (Re-Run, Critical Alerts, Out of Range, Delta Check, Schedule
 * Test) — matches the main Reporting Worklist's own card header exactly.
 * Client-side paginated (`DataTable`'s own `pageSize`) since none of these 5
 * endpoints paginate server-side yet (see TECHNICIAN-REPORTING-GAPS.md). */
function AuxDataTable<T>({
  title,
  columns,
  data,
  getRowId,
  rowActions,
  loading,
  busy,
}: {
  title: string;
  columns: ColumnDef<T>[];
  data: T[];
  getRowId: (row: T) => RowId;
  rowActions: (row: T) => React.ReactNode;
  /** Initial load (TanStack `isLoading`) — blanks the table with a loader. */
  loading?: boolean;
  /** Refetch over already-displayed rows (TanStack `isFetching`) — subtle overlay. */
  busy?: boolean;
}) {
  return (
    <div className="card overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <div className="cardhead flex items-center justify-between border-b border-slate-100 px-4 py-3 font-semibold">
        <span>{title}</span>
        <span className="small">{data.length} records</span>
      </div>
      <DataTable<T>
        columns={columns}
        data={data}
        getRowId={getRowId}
        pageSize={10}
        emptyMessage="No records found"
        wrapperClassName="border-none rounded-none"
        rowActions={rowActions}
        loading={loading}
        busy={busy}
      />
    </div>
  );
}

/* ─── Technician Reports Overview ─── */
/* Shown at /technician/reports/reporting — summary analytics, distinct from the operational worklist at /technician/reporting */

function TechnicianReportsOverview() {
  const [rows, setRows] = useState<TestWiseEntry[]>([]);

  useEffect(() => {
    // Derive live analytics from the actual service data
    technicianService.reports.list().then(data => setRows((data as TestWiseEntry[]).length ? (data as TestWiseEntry[]) : seedRows));
  }, []);

  const deptData = useMemo(() => {
    const depts = ["Biochemistry", "Hematology", "Urine", "Serology"];
    return depts.map(dept => {
      const deptRows = rows.filter(r => (r.testName.includes(dept) || (dept === "Biochemistry" && !r.testName.includes("Urine") && !r.testName.includes("HIV"))));
      const avgTat = deptRows.length ? 4.5 : 0;
      const limit = dept === "Microbiology" ? 24 : 6;
      return {
        dept,
        tests: deptRows.length,
        tat: avgTat,
        tatLimit: limit,
        ok: avgTat <= limit
      };
    });
  }, [rows]);

  const totalTests = rows.length;
  const summaryStats = [
    { label: "Tests Total", value: totalTests, icon: Microscope, color: "text-blue-600", bg: "bg-blue-50" },
    { label: "TAT Compliance", value: `${Math.round((deptData.filter(d => d.ok).length / deptData.length) * 100)}%`, icon: TrendingUp, color: "text-emerald-600", bg: "bg-emerald-50" },
    { label: "Pending Results", value: rows.filter(r => r.status === "Pending").length, icon: Clock, color: "text-yellow-600", bg: "bg-yellow-50" },
    { label: "Approved", value: rows.filter(r => r.status === "Approved").length, icon: CheckCircle2, color: "text-emerald-600", bg: "bg-emerald-50" },
  ];

  return (
    <div className="space-y-6">
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {summaryStats.map(stat => (
          <div key={stat.label} className="rounded-xl border border-slate-200 bg-white p-4 shadow-sm flex items-center gap-3">
            <div className={cn("rounded-lg p-2.5 shrink-0", stat.bg)}>
              <stat.icon className={cn("h-5 w-5", stat.color)} />
            </div>
            <div>
              <div className="text-2xl font-bold text-slate-800">{stat.value}</div>
              <div className="text-xs text-slate-500 mt-0.5">{stat.label}</div>
            </div>
          </div>
        ))}
      </div>

      {/* Charts row */}
      <div className="grid gap-4 lg:grid-cols-2">
        {/* Test Volume by Department */}
        <div className="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
          <div className="flex items-center gap-2 mb-4">
            <BarChart2 className="h-4 w-4 text-blue-600" />
            <span className="font-semibold text-sm text-slate-800">Test Volume by Department</span>
          </div>
          <div className="space-y-3">
            {deptData.map(d => (
              <div key={d.dept}>
                <div className="flex justify-between text-xs mb-1">
                  <span className="text-slate-700">{d.dept}</span>
