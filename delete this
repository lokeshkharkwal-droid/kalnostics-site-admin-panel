  const [homeCollectionFilter, setHomeCollectionFilter] = useState(false);
  // All 6 filters below hold the full selected { id, label } (not just the id)
  // so PaginatedSelect can display the label without needing the option to
  // still be on a loaded page. Branch/Ref By/Panel/Department page against a
  // real backend /options endpoint; Sample Status/Report Status page against
  // the fixed enum lists already in labReportOptions (fetchStaticOptions below
  // wraps them as a single-page fetchPage so every filter uses one consistent
  // component even though there's nothing to actually paginate there).
  const [branchFilter, setBranchFilter] = useState<SelectOption | null>(null);
  const [deptFilter, setDeptFilter] = useState<SelectOption | null>(null);
  const [refPanelFilter, setRefPanelFilter] = useState<SelectOption | null>(null);
  const [refByFilter, setRefByFilter] = useState<SelectOption | null>(null);
