/** Laboratory Module — Analytical TAT + Laboratory Permissions. Backed by
 * `GET/PUT /technician-settings` (one combined tenant+branch-scoped module —
 * see TechnicianSettingsModule on the backend). Not part of the existing
 * 6-item TECHNICIAN SETTINGS dropdown — that dropdown and its pages are
 * untouched. No Save/Cancel buttons of its own — the page-level "Save
 * Changes" button (`TechnicianNewSettingsPage`) drives this via the
 * `onSaveRef` imperative handle, so there's exactly one Save action (and one
 * shared `mutation`/pending state, passed down from the page) on the page,
 * not two. */
function LaboratoryModuleSettings({
  onSaveRef,
  mutation,
}: {
  onSaveRef: React.MutableRefObject<(() => void) | null>;
  mutation: ReturnType<typeof useSaveTechnicianSettings>;
}) {
  const { data, isLoading } = useTechnicianSettings();

  const [form, setForm] = useState<ApiTechnicianSettings | null>(null);
  useEffect(() => {
    if (data) setForm(data);
  }, [data]);

  const set = <K extends keyof ApiTechnicianSettings>(k: K, v: ApiTechnicianSettings[K]) =>
    setForm(p => (p ? { ...p, [k]: v } : p));

  useEffect(() => {
    onSaveRef.current = () => {
      if (!form) return;
      // Only send the editable DTO fields — the GET response also carries
      // id/tenantId/branchId/createdAt/updatedAt/deletedAt, and the backend's
      // ValidationPipe rejects any non-whitelisted property with a 400.
      const {
        tatWarningMinutes, tatCriticalMinutes, tatImminentMinutes,
        isViewRerunIconEnabled, isViewCriticalAlertIconEnabled, isViewOutOfRangeIconEnabled,
        isViewDeltaCheckIconEnabled, isViewScheduledTestIconEnabled,
        authoritySignatures, signatoryBasis,
        isUsefulForEditable, isInterpretationEditable,
        isLimitationsEditable, isRemarksEditable, isReferencesEditable,
        isOverallResultEditable,
      } = form;
      mutation.mutate({
        tatWarningMinutes, tatCriticalMinutes, tatImminentMinutes,
        isViewRerunIconEnabled, isViewCriticalAlertIconEnabled, isViewOutOfRangeIconEnabled,
        isViewDeltaCheckIconEnabled, isViewScheduledTestIconEnabled,
        authoritySignatures, signatoryBasis,
        isUsefulForEditable, isInterpretationEditable,
        isLimitationsEditable, isRemarksEditable, isReferencesEditable,
        isOverallResultEditable,
      });
    };
  });

  if (isLoading || !form) {
    return (
      <div className="flex items-center justify-center py-16 text-gray-400">
        <Loader2 className="w-6 h-6 animate-spin" />
      </div>
    );
  }

  return (
    <div className="space-y-3">
      <SettingsSection title="Laboratory Module - Analytical TAT" defaultOpen>
        <SettingRow label="Warning (minutes remaining to TAT Max)">
          <Input type="number" value={form.tatWarningMinutes}
            onChange={e => set("tatWarningMinutes", Number(e.target.value))} className="h-8 text-xs" />
        </SettingRow>
        <SettingRow label="Critical (minutes remaining)">
          <Input type="number" value={form.tatCriticalMinutes}
            onChange={e => set("tatCriticalMinutes", Number(e.target.value))} className="h-8 text-xs" />
        </SettingRow>
        <SettingRow label="Imminent (minutes remaining)">
          <Input type="number" value={form.tatImminentMinutes}
            onChange={e => set("tatImminentMinutes", Number(e.target.value))} className="h-8 text-xs" />
        </SettingRow>
        <SettingRow label="Breached">
          <div className="text-xs text-gray-500 italic py-1.5">Automatic after TAT Maximum — not editable</div>
        </SettingRow>
      </SettingsSection>

      <SettingsSection title="Laboratory Permissions" defaultOpen>
        <ToggleRow id="viewRerun" label="View Re-Run icon" checked={form.isViewRerunIconEnabled}
          onChange={v => set("isViewRerunIconEnabled", v)} />
        <ToggleRow id="viewCriticalAlert" label="View Critical Alert icon" checked={form.isViewCriticalAlertIconEnabled}
          onChange={v => set("isViewCriticalAlertIconEnabled", v)} />
        <ToggleRow id="viewOutOfRange" label="View Out-of-Range icon" checked={form.isViewOutOfRangeIconEnabled}
          onChange={v => set("isViewOutOfRangeIconEnabled", v)} />
        <ToggleRow id="viewDeltaCheck" label="View Delta Check icon" checked={form.isViewDeltaCheckIconEnabled}
          onChange={v => set("isViewDeltaCheckIconEnabled", v)} />
        <ToggleRow id="viewScheduledTest" label="View Scheduled Test icon" checked={form.isViewScheduledTestIconEnabled}
          onChange={v => set("isViewScheduledTestIconEnabled", v)} />
        <ToggleRow id="usefulForEditable" label="Useful For editable on Test Entry" checked={form.isUsefulForEditable}
          onChange={v => set("isUsefulForEditable", v)} />
        <ToggleRow id="interpretationEditable" label="Interpretation editable on Test Entry" checked={form.isInterpretationEditable}
          onChange={v => set("isInterpretationEditable", v)} />
        <ToggleRow id="limitationsEditable" label="Limitations editable on Test Entry" checked={form.isLimitationsEditable}
          onChange={v => set("isLimitationsEditable", v)} />
        <ToggleRow id="remarksEditable" label="Remarks editable on Test Entry" checked={form.isRemarksEditable}
          onChange={v => set("isRemarksEditable", v)} />
        <ToggleRow id="referencesEditable" label="References editable on Test Entry" checked={form.isReferencesEditable}
          onChange={v => set("isReferencesEditable", v)} />
        <ToggleRow id="overallResultEditable" label="Overall Result editable on Test Entry" checked={form.isOverallResultEditable}
          onChange={v => set("isOverallResultEditable", v)} />
        <SettingRow label="Number of Authority Signatures">
          <Select value={String(form.authoritySignatures)} onValueChange={v => set("authoritySignatures", Number(v))}>
            <SelectTrigger className="h-8 text-xs"><SelectValue /></SelectTrigger>
            <SelectContent>
              {["1", "2", "3"].map(n => <SelectItem key={n} value={n}>{n}</SelectItem>)}
            </SelectContent>
          </Select>
        </SettingRow>
        <SettingRow label="Signatory Depends Based On">
          <Select value={form.signatoryBasis} onValueChange={v => set("signatoryBasis", v as SignatoryBasis)}>
            <SelectTrigger className="h-8 text-xs"><SelectValue /></SelectTrigger>
            <SelectContent>
              {SIGNATORY_BASIS_OPTIONS.map(opt => (
                <SelectItem key={opt.value} value={opt.value}>{opt.label}</SelectItem>
              ))}
            </SelectContent>
          </Select>
        </SettingRow>
        <div className="text-xs text-gray-500 italic">
          Signature authority can be defined at Department, Category, or Sub-Category level (choose one). If Department is selected, the signature will reflect based on department.
        </div>
      </SettingsSection>
    </div>
  );
}

const SETTINGS_PANELS: Record<string, { label: string; icon: React.ElementType; component: React.ReactNode }> = {
  reporting: { label: "Reporting Settings", icon: FileText, component: <ReportingSettings /> },
  qc:        { label: "QC Settings",         icon: Shield,    component: <QCSettings /> },
  pm:        { label: "PM Settings",          icon: Wrench,    component: <PMSettings /> },
  phlebotomist: { label: "Phlebotomist Settings", icon: Droplets, component: <PhlebotomistSettings /> },
};

function TechnicianSettingsPage({ path }: { path: string }) {
  const panelKey = path.includes("/qc") ? "qc"
    : path.includes("/pm") ? "pm"
    : path.includes("/phlebotomist") ? "phlebotomist"
    : "reporting";

  const panel = SETTINGS_PANELS[panelKey];

  return (
    <div className="space-y-4">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2">
          <div className="rounded-lg bg-blue-50 p-2">
            <panel.icon className="h-4 w-4 text-blue-600" />
          </div>
          <div>
            <div className="font-semibold text-sm text-slate-800">{panel.label}</div>
            <div className="text-xs text-slate-500">Configure defaults for your lab</div>
          </div>
        </div>
        <Button size="sm" className="h-8 text-xs gap-1.5" onClick={() => toast.success("Settings saved")}>
          <Save className="h-3.5 w-3.5" /> Save Changes
        </Button>
      </div>

      {panel.component}
    </div>
  );
}

/** New `/technician/settings` page (bare path — the sidebar's own
 * TECHNICIAN SETTINGS dropdown and its 6 existing sub-pages are untouched;
 * that button never links here today, it only expands the dropdown, so this
 * path was previously unreachable). Only the 2 sections requested — Analytical
 * TAT and Laboratory Permissions — same mock accordion pattern as every
 * other settings panel above.
 *
 * Bug fix: this used to render its own "Technician Settings" title/subtitle
 * row, directly duplicating the real page header `RoleDashboard` (Role/index.tsx)
 * already renders above every page from `sidebarItem.label` ("TECHNICIAN
 * SETTINGS") — the same duplication exists on the older `TechnicianSettingsPage`
 * below too, just less obvious there since its per-panel label ("Reporting
 * Settings" etc.) reads as a sub-level breadcrumb rather than a literal
 * repeat. Dropped the redundant top-level title/subtitle here; kept only the
 * Save button (still needs somewhere to live).
 *
 * Each section below is exactly ONE top-level accordion (`SettingsSection`,
 * `defaultOpen`), not a plain header + nested sub-accordions — per user
 * request, everything belonging to a section lives inside its own single
 * accordion body, open by default, with the accordion's own title as the
 * only header (no separate icon+label row above it, to avoid re-duplicating
 * the title).
 *
 * Bug fix: `LaboratoryModuleSettings` used to render its own real Save/Cancel
 * row *underneath* this page's own "Save Changes" button — two save actions
 * on one page, and the top one was a leftover mock (`toast.success` only,
 * no API call), while the real one lived below. Removed the duplicate: this
 * is now the only Save button, wired to the real mutation via `onSaveRef`. */
function TechnicianNewSettingsPage() {
  const onSaveRef = useRef<(() => void) | null>(null);
  const mutation = useSaveTechnicianSettings();
  const canUpdateSettings = usePermissions().hasPermission(LP.SETTINGS_UPDATE);

  return (
    <div className="space-y-4">
      <div className="flex justify-end">
        <Button
          size="sm"
          className="h-8 text-xs gap-1.5"
          disabled={mutation.isPending || !canUpdateSettings}
          title={!canUpdateSettings ? "You do not have permission to update laboratory settings" : undefined}
          onClick={() => onSaveRef.current?.()}
        >
          {mutation.isPending
            ? <Loader2 className="h-3.5 w-3.5 animate-spin" />
            : <Save className="h-3.5 w-3.5" />}
          {mutation.isPending ? "Saving…" : "Save Changes"}
        </Button>
      </div>

      <LaboratoryModuleSettings onSaveRef={onSaveRef} mutation={mutation} />
    </div>
  );
}

export default function TechnicianDashboard({ activeTab }: { activeTab?: string }) {
  const location = useLocation();
  const path = location.pathname;

  if (path.includes("/quality-controls")) return <QCDashboard activeTab={activeTab} path={path} />;
  if (path.includes("/calibration")) return <CalibrationDashboard activeTab={activeTab} path={path} />;
  if (path.includes("/preventive-maintenance")) return <PreventiveMaintenanceDashboard activeTab={activeTab} path={path} />;
  if (path.includes("/test-process")) return <TestProcessDashboard activeTab={activeTab} path={path} />;
  if (path.includes("/reports/")) return <TechnicianReportsOverview />;
  if (path.includes("/settings/")) return <TechnicianSettingsPage path={path} />;
  if (path === "/technician/settings") return <TechnicianNewSettingsPage />;

  return <TechnicianReportingPage activeTab={activeTab} />;
}

