# ── kalnostics-fe environment ───────────────────────────────────────
# The frontend runs on :3001 and talks to the kalnostics-new backend.

# Backend origin used by the Next.js dev proxy (next.config.js rewrites).
# All browser /api/* calls are proxied here, so no CORS config is needed.
API_URL=http://localhost:3000

# Public app metadata
APP_NAME=Kalnostics
APP_URL=http://localhost:3001

# Leave empty so Axios issues same-origin /api/v1/* requests that the
# dev proxy forwards to API_URL. Only set this to an absolute backend URL
# if you intend to bypass the proxy (then enable CORS on the backend).
NEXT_PUBLIC_API_URL=
